@model CMC.Presentation.Application.DTOs.Questions.QuestionVM

@using Microsoft.AspNetCore.Http;
@using CMC.Kernel.Core.Constants
@using CMC.Presentation.Application.DTOs.Identity
@using Newtonsoft.Json
@inject IHttpContextAccessor HttpContextAccessor


@{
    ViewData["Title"] = Localizer["AddNewQuestion"].Value;
    bool IsAr = Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName == "ar";
    UserDTO userInfoDTO = HttpContextAccessor.HttpContext.Session.GetString("UserInfoDTO") != null ?
      JsonConvert.DeserializeObject<UserDTO>(HttpContextAccessor.HttpContext.Session.GetString("UserInfoDTO")) : null;
}

<style>
    .option-textbox {
        margin: 0px 10px;
    }

    .option-row {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
    }

    .option-textbox {
        flex: 1;
        margin-left: 5px;
    }

    .option-label {
        display: flex;
        align-items: center;
    }

    .option-radio {
        display: none; /* Hide the actual radio button */
    }

        .option-radio:checked + .radio-custom {
            border-color: green; /* Change border color when radio is checked */
        }

    .radio-custom {
        display: inline-block;
        width: 16px;
        height: 16px;
        border: 2px solid #000;
        border-radius: 50%;
        margin-right: 5px;
    }

    .correct-option {
        border: 2px solid green;
    }

    .margin-text-box {
        margin: 0 10px;
    }
</style>




<div class="flex flex-column justify-content-center align-items-center">
    <div class="row justify-content-between">
        <div class="col-12 d-flex flex-row justify-content-between">
            <h6 class="justify-content-start align-middle align-self-center mb-3">@Localizer["QuestionsBank"] - @Localizer["AddNewQuestion"]</h6>
        </div>
    </div>
    <div class="card">
        <div class="card-body">
            <div class="register py-3 p-md-4 h-100" style="overflow-y: auto">
                <input type="hidden" asp-for="Id" />
                <div class="mb-2">

                    <!--Drop down list for category-->
                    <div class="form-group">
                        <label class="requiredLabel">@Localizer["Category"]</label>
                        <div class="form-row">
                            <div class="form-group col-md-2">
                                <select id="ddlCategories" class="form-select w-100" asp-for="CategoryId" asp-items="@(new SelectList(Model.Categories, "Id", IsAr ? "NameAr" : "NameEn"))">
                                    <option value="">@Localizer["Select"]</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!--Question text [ Arabic - English ] -->
                    <div class="form-group">
                        <label class="requiredLabel">@Localizer["QuestionText"]</label>
                        <div class="form-row">
                            @if (IsAr)
                            {
                                <div class="form-group col-md-4">
                                    <input class="form-control" type="text" asp-for="TextAr" placeholder="@Localizer["InArabic"]" />
                                    <span asp-validation-for="TextAr" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-4">
                                    <input class="form-control" type="text" asp-for="TextEn" placeholder="@Localizer["InEnglish"]" />
                                    <span asp-validation-for="TextEn" class="text-danger"></span>
                                </div>
                            }
                            else
                            {
                                <div class="form-group col-md-4">
                                    <input class="form-control" type="text" asp-for="TextEn" placeholder="@Localizer["InEnglish"]" />
                                    <span asp-validation-for="TextEn" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-4">
                                    <input class="form-control" type="text" asp-for="TextAr" placeholder="@Localizer["InArabic"]" />
                                    <span asp-validation-for="TextAr" class="text-danger"></span>
                                </div>
                            }
                        </div>

                        <!--If Image for question is exist-->
                        @{
                            string imgQuestionPath = !string.IsNullOrEmpty(Model.ImgPath) ? $"data:image/jpeg;base64,{Model.ImgPath}" : "";
                            string displayedQuestionImg = !string.IsNullOrEmpty(Model.ImgPath) ? "" : "display:none";
                            string IdOfImg = !string.IsNullOrEmpty(Model.ImgPath) ? Model.Id.Value.ToString() : "";
                        }
                        <input type="hidden" id="hdn-curr-img-id" value="@IdOfImg" />
                        <div class="form-row">
                            <div class="col-md-3">
                                <div class="category-box" style="cursor:pointer">
                                    <div class="image-container p-3" id="dv-img-question">
                                        <img src="@imgQuestionPath" class="w-50" alt="Image" style="@displayedQuestionImg">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!--File upload for question image -->
                        <div class="form-row">
                            <div class="form-group col-md-4 d-flex flex-column d-flex">
                                <div class="custom-file">
                                    <input type="file" name="Img" class="custom-file-input" id="question-img" style="cursor:pointer" data-answer="2" data-hide="btnDeleteQuestionImg"
                                           placeholder="@Localizer["ChooseImg"].Value" accept=".jpg, .jpeg, .png">
                                    <label class="custom-file-label upload-btn" for="file">
                                        <span id="lblQuestionImgName">@Localizer["ChooseImg"]</span>
                                        <span class="danger"></span> <i id="lblQuestionImgStatus" class="fas fa-upload"></i>
                                    </label>
                                </div>
                                <span id="question-Img-invalid" class="text-danger field-validation-error"></span>
                            </div>

                            <!-- Button to delete existing image for questions -->
                            <div class="form-group col-md-4 px-3 m-0" id="dv-btn-delete-image-question" style="@displayedQuestionImg">
                                <button type="button" id="btnDeleteQuestionImg" onclick="Categories.DeleteExistingImg(2,'dv-img-question',this)" class="btn btn-danger btn-md m-0"><i class="fas fa-trash"></i>@Localizer["DeleteExistingImage"]</button>
                            </div>
                            <div class="form-group col-md-12" id="dv-delete-question-status" style="display:none">
                                <div>
                                    <span class="h6 h6-responsive mr-2 ml-0 float-left">
                                        <i style="display:none" class="fas fa-check-circle text-success i-success-delete-img"></i>
                                        <i style="display:none" class="fas fa-exclamation-circle text-danger i-error-delete-img"></i>
                                    </span>
                                    <span class="spn-delete-img-status">
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Question Time / Point / Type of answers -->
                    <div class="form-group">
                        <div class="form-row">
                            <div class="form-group col-md-3">
                                <label class="requiredLabel">@Localizer["AnswersType"]</label>
                                <select id="ddlAnswersType" class="form-select w-100" asp-for="AnswertType" style="height:60%">
                                    <option value="1">@Localizer["AnswersTypeText"]</option>
                                    <option value="2">@Localizer["AnswersTypeImg"]</option>
                                </select>
                                <span asp-validation-for="AnswertType" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="register py-3 p-md-4 h-100" style="overflow-y: auto">
                <div class="row mb-3">
                    <label for="Options" class="col-sm-1">@Localizer["Options"]</label>
                </div>
                <div class="row mb-3">

                    <!--Asnwers Text-->
                    <div class="col-sm-10 dv-options dv-answers-text">
                        <div class="option" data-count="1">
                            <div class="option-row">
                                <input type="hidden" id="hdn-option-id-1" />
                                <label class="option-label">
                                    <input class="form-check-input" type="radio" name="correctOption" id="chk-option-1" onchange="Questions.SelectAnswer(this)">
                                </label>
                                @if (IsAr)
                                {
                                    <input class="form-control margin-text-box option-textbox-ar" type="text" id="txt-option-ar-1" placeholder="@Localizer["Option1"] @Localizer["InArabic"]" />
                                    <input class="form-control margin-text-box option-textbox-en" type="text" id="txt-option-en-1" placeholder="@Localizer["Option1"] @Localizer["InEnglish"]" />
                                }
                                else
                                {
                                    <input class="form-control margin-text-box option-textbox-en" type="text" id="txt-option-en-1" placeholder="@Localizer["Option1"] @Localizer["InEnglish"]" />
                                    <input class="form-control margin-text-box option-textbox-ar" type="text" id="txt-option-ar-1" placeholder="@Localizer["Option1"] @Localizer["InArabic"]" />
                                }
                                <span class="text-danger field-validation-valid" data-valmsg-replace="true" style="margin:0 20px"></span>
                            </div>
                            <div class="option" data-count="2">
                                <div class="option-row">
                                    <input type="hidden" id="hdn-option-id-2" />
                                    <label class="option-label">
                                        <input class="form-check-input" type="radio" name="correctOption" id="chk-option-2" onchange="Questions.SelectAnswer(this)">
                                    </label>

                                    @if (IsAr)
                                    {
                                        <input class="form-control margin-text-box option-textbox-ar" type="text" id="txt-option-ar-2" placeholder="@Localizer["Option2"] @Localizer["InArabic"]" />
                                        <input class="form-control margin-text-box option-textbox-en" type="text" id="txt-option-en-2" placeholder="@Localizer["Option2"] @Localizer["InEnglish"]" />
                                    }
                                    else
                                    {
                                        <input class="form-control margin-text-box option-textbox-en" type="text" id="txt-option-en-2" placeholder="@Localizer["Option2"] @Localizer["InEnglish"]" />
                                        <input class="form-control margin-text-box option-textbox-ar" type="text" id="txt-option-ar-2" placeholder="@Localizer["Option2"] @Localizer["InArabic"]" />
                                    }
                                </div>
                                <span class="text-danger field-validation-valid" data-valmsg-replace="true" style="margin:0 20px"></span>
                            </div>
                            <div class="option" data-count="3">
                                <div class="option-row">
                                    <input type="hidden" id="hdn-option-id-3" />
                                    <label class="option-label">
                                        <input class="form-check-input" type="radio" name="correctOption" id="chk-option-3" onchange="Questions.SelectAnswer(this)">
                                    </label>
                                    @if (IsAr)
                                    {
                                        <input class="form-control margin-text-box option-textbox-ar" type="text" id="txt-option-ar-3" placeholder="@Localizer["Option3"] @Localizer["InArabic"]" />
                                        <input class="form-control margin-text-box option-textbox-en" type="text" id="txt-option-en-3" placeholder="@Localizer["Option3"] @Localizer["InEnglish"]" />
                                    }
                                    else
                                    {
                                        <input class="form-control margin-text-box option-textbox-en" type="text" id="txt-option-en-3" placeholder="@Localizer["Option3"] @Localizer["InEnglish"]" />
                                        <input class="form-control margin-text-box option-textbox-ar" type="text" id="txt-option-ar-3" placeholder="@Localizer["Option3"] @Localizer["InArabic"]" />
                                    }
                                </div>
                                <span class="text-danger field-validation-valid" data-valmsg-replace="true" style="margin:0 20px"></span>
                            </div>
                            <div class="option" data-count="4">
                                <div class="option-row">
                                    <input type="hidden" id="hdn-option-id-4" />
                                    <label class="option-label">
                                        <input class="form-check-input" type="radio" name="correctOption" id="chk-option-4" onchange="Questions.SelectAnswer(this)">
                                    </label>
                                    @if (IsAr)
                                    {
                                        <input class="form-control margin-text-box option-textbox-ar" type="text" id="txt-option-ar-4" placeholder="@Localizer["Option4"] @Localizer["InArabic"]" />
                                        <input class="form-control margin-text-box option-textbox-en" type="text" id="txt-option-en-4" placeholder="@Localizer["Option4"] @Localizer["InEnglish"]" />
                                    }
                                    else
                                    {
                                        <input class="form-control margin-text-box option-textbox-en" type="text" id="txt-option-en-4" placeholder="@Localizer["Option4"] @Localizer["InEnglish"]" />
                                        <input class="form-control margin-text-box option-textbox-ar" type="text" id="txt-option-ar-4" placeholder="@Localizer["Option4"] @Localizer["InArabic"]" />
                                    }
                                </div>
                            </div>
                            <span class="text-danger field-validation-valid" data-valmsg-replace="true" style="margin:0 20px;"></span>
                        </div>
                    </div>


                    <!--Asnwers Image-->
                    <div class="col-sm-10 dv-options dv-answers-images d-none">

                        @{
                            int counterAnswers = 4;
                            int counterModelAnswers = Model.Answers.Count;
                            bool IsImg = Model.Answers.Any(a => a.IsImg);
                        }
                        @for (var i = 0; i < counterAnswers; i++)
                        {
                            string mainId = (i + 1).ToString();
                            string ImgAnswerPath = "";
                            string displayedAnswerImg = "display:none";
                            string AnswerImgId = "";
                            string IsCorrectAnswer = "";
                            string FileName = Localizer["ChooseImg"].Value;
                            if (i < counterModelAnswers && IsImg)
                            {
                                ImgAnswerPath = Model.Answers[i].ImgPath != null ? $"data:image/jpeg;base64,{Model.Answers[i].ImgPath}" : "";
                                displayedAnswerImg = !string.IsNullOrEmpty(ImgAnswerPath) ? "" : "display:none";
                                AnswerImgId = !string.IsNullOrEmpty(ImgAnswerPath) ? Model.Answers[i].Id.Value.ToString() : "";
                                IsCorrectAnswer = Model.Answers[i].IsAnswer ? "checked=checked" : "";
                                FileName = !string.IsNullOrEmpty(Model.Answers[i].ImgName) ? Model.Answers[i].ImgName : Localizer["ChooseImg"].Value;
                            }

                            <!--Main row for each option-->
                            <div class="option" data-count="@mainId">

                                <!--answer- Imgage for option-->
                                <div class="form-row">
                                    <div class="col-md-3">
                                        <div class="category-box" style="cursor:pointer" onclick="Questions.SelectAnswerByImage('@mainId')">
                                            <div class="image-container p-3" id="dv-imgOptionAns-@mainId">
                                                <img src="@ImgAnswerPath" class="w-50" alt="Image" style="@displayedAnswerImg">
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="option-row">
                                    <!--answer - Radio button to select correct answer-->
                                    <input type="hidden" id="hdn-option-img-id-@mainId" value="@AnswerImgId" />
                                    <label class="option-label">
                                        <input class="form-check-input" type="radio" name="correctOptionImg" id="chk-option-img-@mainId" @IsCorrectAnswer onchange="Questions.SelectAnswer(this)" style="pointer-events:none">
                                    </label>

                                    <!-- answer - File upload-->
                                    <div class="form-group col-md-4 d-flex flex-column d-flex" style="margin:0 -15px;">
                                        <div class="custom-file">
                                            <input type="file" name="Img" class="custom-file-input" id="answer-img-@mainId" style="cursor:pointer" data-answer="@mainId" data-hide="btnDeleteAnsImg-@mainId"
                                                   placeholder="@Localizer["ChooseImg"].Value" accept=".jpg, .jpeg, .png">
                                            <label class="custom-file-label upload-btn" for="file">
                                                <span id="lblImageName-@mainId">@FileName</span>
                                                <span class="danger"></span> <i id="lblImgStatus-@mainId" class="fas fa-upload"></i>
                                            </label>
                                        </div>
                                        <span id="answer-Img-invalid-@mainId" class="text-danger field-validation-error"></span>
                                    </div>


                                    <!--answer If Img is exist, then show button to delete current image answer-->
                                    <div class="form-group col-md-4 m-0" id="dv-btn-delete-image-ans-@mainId" style="@displayedAnswerImg">
                                        <button type="button" data-id="@mainId" class="btn btn-danger btn-md m-0" id="btnDeleteAnsImg-@mainId" onclick="Categories.DeleteExistingImg(3,'dv-imgOptionAns-@mainId',this)"><i class="fas fa-trash"></i>@Localizer["DeleteImage"]</button>
                                    </div>

                                    <!--answer - Image deleted status-->
                                    <div class="form-group col-md-12 px-3 m-0" id="dv-delete-answer-status-@mainId" style="display:none">
                                        <span class="h6 h6-responsive mr-2 ml-0 float-left">
                                            <i style="display:none" class="fas fa-check-circle text-success i-success-delete-img"></i>
                                            <i style="display:none" class="fas fa-exclamation-circle text-danger i-error-delete-img"></i>
                                        </span>
                                        <span class="spn-delete-img-status">
                                        </span>
                                    </div>
                                </div>
                                <span class="text-danger field-validation-valid" data-valmsg-replace="true" style="margin:0 20px"></span>
                            </div>
                        }
                    </div>
                    <div class="col-sm-5">
                        <span class="text-danger field-validation-valid" data-valmsg-for="Answers" id="lbl-generic-error" data-valmsg-replace="true" style="margin:0 20px"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 text-center">
        <button type="button" class="btn btn-primary" onclick="Questions.AddNewQuestion()">@Localizer["Save"]</button>
        <button type="button" class="btn btn-secondary" onclick="window.location.href='@Url.Action("AddCategory", "Questions",new { id = Model.CategoryId })';">@Localizer["Cancel"]</button>
        @if (Model.Id.HasValue && userInfoDTO.PermissionCodes.Contains(PermissionCodes.WebQuestionsDelete))
        {
            <button type="button" onclick="Questions.DeleteQuestion(this)" data-category="@Model.CategoryId" id="btndelete_@Model.Id" class="btn btn-danger">@Localizer["Delete"]</button>
        }
    </div>
</div>


<!-- end row -->
<script src="~/assets/js/Application/QuestionsCategories.js"></script>


<script>
    Questions.OnLoad();
    GeneralClass.ActivationSubMenuItem('#lnkQuestions', '#lnkQuestionAdd');
    GeneralClass.ActivationSubMenuItem('#lnkQuestions2', '#lnkQuestionAdd2');
</script>

@if (Model.Id.HasValue && Model.Answers != null && Model.Answers.Count > 0)
{
    <script>
        function decodeHtmlEntities(encodedString) {
            var textArea = document.createElement('textarea');
            textArea.innerHTML = encodedString;
            return textArea.value;
        }
    </script>
    var counter = 1;

    @if (Model.AnswertType == 2)
    {
        <script>
            $('.dv-answers-text').addClass('d-none');
            $('.dv-answers-images').removeClass('d-none');
        </script>
    }
    else
    {
        foreach (var answer in Model.Answers)
        {
            <script>
                $('#txt-option-ar-' + '@counter').val(decodeHtmlEntities('@answer.TextAr'));
                $('#txt-option-en-' + '@counter').val('@answer.TextEn');
                $('#hdn-option-id-' + '@counter').val('@answer.Id');

                if ('@answer.IsAnswer'.toString().toLowerCase() == 'true') {
                    $('#chk-option-' + '@counter').prop('checked', 'checked');
                    Questions.SelectAnswer($('#chk-option-' + '@counter'));
                }
            </script>
            counter++;
        }
    }
}


