@model CMC.Presentation.Application.DTOs.Questions.QuestionVM

@using Microsoft.AspNetCore.Http;
@using CMC.Kernel.Core.Constants
@using CMC.Presentation.Application.DTOs.Identity
@using Newtonsoft.Json
@inject IHttpContextAccessor HttpContextAccessor


@{
    ViewData["Title"] = Localizer["AddNewQuestion"].Value;
    bool IsAr = Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName == "ar";
    UserDTO userInfoDTO = HttpContextAccessor.HttpContext.Session.GetString("UserInfoDTO") != null ?
      JsonConvert.DeserializeObject<UserDTO>(HttpContextAccessor.HttpContext.Session.GetString("UserInfoDTO")) : null;
}

<style>
    :root {
        --primary-color: #3b82f6;
        --primary-dark: #1d4ed8;
        --secondary-color: #64748b;
        --success-color: #10b981;
        --success-dark: #059669;
        --warning-color: #f59e0b;
        --warning-dark: #d97706;
        --danger-color: #ef4444;
        --danger-dark: #dc2626;
        --light-bg: #f8fafc;
        --card-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        --card-hover-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15);
        --border-color: #e2e8f0;
        --text-primary: #1f2937;
        --text-secondary: #6b7280;
        --text-muted: #9ca3af;
    }

    /* ===== MAIN CONTAINER ===== */
    .main-container {
        background: var(--light-bg);
        min-height: 100vh;
        padding: 2rem;
    }

    /* ===== BASE CARD STYLES ===== */
    .card {
        border: none;
        border-radius: 16px;
        box-shadow: var(--card-shadow);
        transition: all 0.3s ease;
        background: white;
        overflow: hidden;
    }

    .card:hover {
        box-shadow: var(--card-hover-shadow);
        transform: translateY(-2px);
    }

    /* ===== UPLOAD ZONE STYLES ===== */
    .upload-zone {
        border: 2px dashed var(--primary-color);
        border-radius: 12px;
        padding: 2rem;
        text-align: center;
        transition: all 0.3s ease;
        background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
        cursor: pointer;
        max-width: 100%;
        box-sizing: border-box;
        overflow: hidden;
        word-wrap: break-word;
    }

    .upload-zone:hover, 
    .upload-zone.dragover {
        border-color: var(--success-color);
        background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
        transform: scale(1.02);
    }

    .upload-zone-clean {
        border: 2px dashed var(--border-color);
        border-radius: 12px;
        background: #fafbfc;
        cursor: pointer;
        transition: all 0.3s ease;
        padding: 3rem 2rem;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .upload-zone-clean:hover {
        border-color: var(--primary-color);
        background: #f8faff;
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(59, 130, 246, 0.1);
    }

    .upload-zone-clean.dragover {
        border-color: var(--success-color);
        background: #f0fdf4;
        transform: scale(1.01);
    }

    .upload-icon {
        font-size: 3rem;
        color: var(--primary-color);
        margin-bottom: 1rem;
        transition: all 0.3s ease;
    }

    .upload-zone-clean:hover .upload-icon {
        transform: scale(1.1);
        color: var(--success-color);
    }

    /* ===== STATISTICS CARDS ===== */
    .stat-card-clean {
        background: white;
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 2rem;
        text-align: center;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        box-shadow: var(--card-shadow);
    }

    .stat-card-clean::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, var(--primary-color), var(--success-color));
        border-radius: 16px 16px 0 0;
    }

    .stat-card-clean:hover {
        box-shadow: var(--card-hover-shadow);
        transform: translateY(-4px);
    }

    .stat-number {
        font-size: 2.5rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
        background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1.2;
    }

    .stat-label {
        font-size: 0.9rem;
        color: var(--text-secondary);
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    /* ===== QUESTIONS CONTAINER ===== */
    #questionsListContainer {
        max-height: 650px;
        overflow-y: auto;
        padding: 1.5rem;
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-radius: 12px;
        position: relative;
        border: 1px solid var(--border-color);
    }

    .questions-container-enhanced {
        background: white;
        border-radius: 16px;
        box-shadow: var(--card-shadow);
        overflow: hidden;
        border: 1px solid var(--border-color);
    }

    .questions-header-enhanced {
        background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
        padding: 1.5rem 2rem;
        border-bottom: 1px solid var(--border-color);
    }

    .questions-header-enhanced h5 {
        margin: 0;
        color: var(--text-primary);
        font-weight: 700;
        font-size: 1.25rem;
    }

    /* ===== QUESTION CARDS ===== */
    .question-card-clean {
        background: white;
        border: 1px solid var(--border-color);
        border-radius: 16px;
        margin-bottom: 1.5rem;
        transition: all 0.3s ease;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        position: relative;
        overflow: hidden;
        animation: slideInUp 0.3s ease-out;
    }

    .question-card-clean:hover {
        box-shadow: 0 12px 32px rgba(0,0,0,0.12);
        transform: translateY(-4px);
    }

    .question-card-clean.border-success {
        border-left: 5px solid var(--success-color);
        background: linear-gradient(135deg, #ffffff 0%, #f0fdf4 100%);
    }

    .question-card-clean.border-warning {
        border-left: 5px solid var(--warning-color);
        background: linear-gradient(135deg, #ffffff 0%, #fffbeb 100%);
    }

    .question-card-clean.border-danger {
        border-left: 5px solid var(--danger-color);
        background: linear-gradient(135deg, #ffffff 0%, #fef2f2 100%);
    }

    /* ===== CHECKBOX FIXES ===== */
    .question-card-clean .form-check-input {
        position: relative !important;
        float: none !important;
        margin-right: 0.75rem;
        margin-top: 0.125rem;
        z-index: 2;
        transform: scale(1.3);
        accent-color: var(--primary-color);
    }

    .question-card-clean .form-check-input:checked {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
    }

    /* ===== BADGES AND LABELS ===== */
    .badge-primary {
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
        color: white;
        padding: 0.6rem 1rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.75rem;
        box-shadow: 0 2px 8px rgba(59, 130, 246, 0.3);
        text-transform: uppercase;
        letter-spacing: 0.025em;
    }

    /* ===== ANSWER OPTIONS ===== */
    .answer-option-clean {
        padding: 1rem 1.25rem;
        margin: 0.75rem 0;
        border-radius: 10px;
        border: 1px solid #e5e7eb;
        background: #fafbfc;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .answer-option-clean:hover {
        border-color: var(--primary-color);
        background: #f8faff;
        transform: translateX(4px);
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.1);
    }

    .answer-option-clean.correct {
        background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
        border-color: var(--success-color);
        position: relative;
    }

    .answer-option-clean.correct::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 4px;
        background: linear-gradient(to bottom, var(--success-color), var(--success-dark));
    }

    .answer-option-clean.correct::after {
        content: '✓';
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--success-color);
        font-weight: bold;
        font-size: 1.4rem;
        text-shadow: 0 1px 2px rgba(16, 185, 129, 0.2);
    }

    /* ===== BUTTONS ===== */
    .btn-primary {
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
        border: none;
        border-radius: 10px;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 2px 8px rgba(59, 130, 246, 0.2);
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(59, 130, 246, 0.4);
        background: linear-gradient(135deg, var(--primary-dark) 0%, #1e40af 100%);
    }

    .btn-success {
        background: linear-gradient(135deg, var(--success-color) 0%, var(--success-dark) 100%);
        border: none;
        border-radius: 10px;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 2px 8px rgba(16, 185, 129, 0.2);
    }

    .btn-success:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(16, 185, 129, 0.4);
    }

    .btn-danger {
        background: linear-gradient(135deg, var(--danger-color) 0%, var(--danger-dark) 100%);
        border: none;
        border-radius: 10px;
        padding: 0.5rem 1rem;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 2px 8px rgba(239, 68, 68, 0.2);
    }

    .btn-danger:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(239, 68, 68, 0.4);
    }

    .btn-sm.btn-outline-primary,
    .btn-sm.btn-outline-danger {
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-weight: 500;
        transition: all 0.2s ease;
        border-width: 1.5px;
    }

    .btn-sm.btn-outline-primary:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
        background: var(--primary-color);
        border-color: var(--primary-color);
    }

    .btn-sm.btn-outline-danger:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
        background: var(--danger-color);
        border-color: var(--danger-color);
    }

    /* ===== TABS ===== */
    .nav-tabs {
        border: none;
        margin-bottom: 2rem;
    }

    .nav-tabs .nav-link {
        border: none;
        border-radius: 12px;
        padding: 1rem 1.5rem;
        font-weight: 600;
        color: var(--secondary-color);
        transition: all 0.3s ease;
        margin-right: 0.5rem;
        background: white;
        box-shadow: var(--card-shadow);
    }

    .nav-tabs .nav-link:hover {
        background: var(--light-bg);
        transform: translateY(-2px);
    }

    .nav-tabs .nav-link.active {
        background: var(--primary-color);
        color: white;
        box-shadow: var(--card-hover-shadow);
    }

    .tab-content {
        background: white;
        border: 1px solid #dee2e6;
        border-top: none;
        border-radius: 0 0 12px 12px;
        padding: 1.5rem;
    }

    /* ===== TEXT STYLING ===== */
    .question-card-clean strong {
        color: var(--text-primary);
        font-weight: 600;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.025em;
    }

    .question-card-clean p {
        color: var(--text-secondary);
        line-height: 1.6;
        font-size: 0.95rem;
        margin-bottom: 0.5rem;
    }

    .text-muted {
        color: var(--text-muted) !important;
    }

    /* ===== SCROLLBAR STYLING ===== */
    #questionsListContainer::-webkit-scrollbar {
        width: 8px;
    }

    #questionsListContainer::-webkit-scrollbar-track {
        background: #f1f5f9;
        border-radius: 4px;
    }

    #questionsListContainer::-webkit-scrollbar-thumb {
        background: linear-gradient(135deg, #cbd5e1, #94a3b8);
        border-radius: 4px;
    }

    #questionsListContainer::-webkit-scrollbar-thumb:hover {
        background: linear-gradient(135deg, #94a3b8, #64748b);
    }

    /* ===== WARNING MESSAGES ===== */
    .warning-message {
        background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
        border: 1px solid var(--warning-color);
        border-radius: 8px;
        padding: 0.75rem 1rem;
        color: #92400e;
        font-size: 0.85rem;
        margin-top: 0.5rem;
    }

    .warning-message i {
        color: var(--warning-color);
        margin-right: 0.5rem;
    }

    /* ===== MODAL STYLES ===== */
    .modal {
        z-index: 1060 !important;
    }

    .modal-backdrop {
        z-index: 1040 !important;
    }

    .modal-dialog {
        z-index: 1070 !important;
        max-width: 90%;
        margin: 1.75rem auto;
    }

    .excel-modal {
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(10px);
        z-index: 1090 !important;
    }

    .excel-modal-dialog {
        max-width: 95vw;
        width: 1200px;
        margin: 2rem auto;
        z-index: 1095 !important;
    }

    .excel-modal-content {
        border: none;
        border-radius: 16px;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.25);
        background: white;
        overflow: hidden;
    }

    .excel-modal-header {
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
        color: white;
        padding: 1.5rem 2rem;
        border: none;
    }

    .excel-modal-header h4 {
        margin: 0;
        font-weight: 700;
    }

    .excel-modal-body {
        padding: 2rem;
        max-height: 70vh;
        overflow-y: auto;
    }

    .excel-modal-footer {
        background: var(--light-bg);
        padding: 1rem 2rem;
        border: none;
    }

    /* ===== DOWNLOAD BUTTONS ===== */
    .download-btn {
        background: linear-gradient(135deg, var(--success-color) 0%, var(--success-dark) 100%);
        color: white;
        padding: 0.75rem 1.5rem;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s ease;
        margin: 0.5rem;
        text-decoration: none;
        display: inline-block;
    }

    .download-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(16, 185, 129, 0.3);
        color: white;
    }

    .download-btn i {
        margin-right: 0.5rem;
    }

    /* ===== MODAL TABLES ===== */
    .modal-preview-table {
        width: 100%;
        border-collapse: collapse;
        margin: 1rem 0;
        background: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        font-size: 12px;
    }

    .modal-preview-table th,
    .modal-preview-table td {
        padding: 8px;
        text-align: left;
        border-bottom: 1px solid #eee;
        word-wrap: break-word;
        max-width: 120px;
    }

    .modal-preview-table th {
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
        color: white;
        font-weight: 600;
        font-size: 11px;
        position: sticky;
        top: 0;
    }

    .modal-preview-table tr:hover {
        background: #f8f9ff;
    }

    /* ===== MODAL GRIDS ===== */
    .modal-column-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1rem;
        margin: 1rem 0;
    }

    .modal-column-item {
        background: var(--light-bg);
        padding: 1rem;
        border-radius: 8px;
        border-left: 3px solid var(--primary-color);
    }

    .modal-column-name {
        font-weight: bold;
        color: var(--primary-color);
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
    }

    .modal-column-desc {
        color: #666;
        font-size: 0.8rem;
    }

    /* ===== ALERT STYLES ===== */
    .alert {
        margin: 0 auto 15px auto;
        z-index: 1030;
        word-wrap: break-word;
        text-align: center;
        position: relative;
        border-radius: 8px;
    }

    .alert-info {
        background: #f0f9ff;
        border-color: #bae6fd;
        color: #0c4a6e;
    }

    .alert-success {
        background-color: #d4edda;
        border-color: #c3e6cb;
        color: #155724;
    }

    .alert-danger {
        background-color: #f8d7da;
        border-color: #f5c6cb;
        color: #721c24;
    }

    .alert-warning {
        background-color: #fff3cd;
        border-color: #ffeaa7;
        color: #856404;
    }

    .modal-alert-warning {
        background: #fff3cd;
        border: 1px solid #ffeaa7;
        color: #856404;
        padding: 1rem;
        border-radius: 8px;
        margin: 1rem 0;
        font-size: 0.9rem;
    }

    .modal-alert-success {
        background: #d4edda;
        border: 1px solid #c3e6cb;
        color: #155724;
        padding: 1rem;
        border-radius: 8px;
        margin: 1rem 0;
        font-size: 0.9rem;
    }

    .modal-alert-warning ul,
    .modal-alert-success ul {
        margin: 0.5rem 0 0 1rem;
        padding: 0;
    }

    /* ===== UTILITIES ===== */
    .loading-spinner {
        display: none;
        color: var(--primary-color);
    }

    .fade-in {
        animation: fadeIn 0.5s ease-in;
    }

    .progress-bar {
        background: linear-gradient(90deg, var(--primary-color) 0%, var(--success-color) 100%);
        border-radius: 4px;
    }

    /* ===== ANIMATIONS ===== */
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes slideInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }
        50% {
            opacity: 0.7;
        }
    }

    /* ===== LEGACY COMPATIBILITY ===== */
    .option-textbox {
        margin: 0px 10px;
    }

    .option-row {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
    }

    .option-label {
        display: flex;
        align-items: center;
    }

    .option-radio {
        display: none;
    }

    .option-radio:checked + .radio-custom {
        border-color: green;
    }

    .radio-custom {
        display: inline-block;
        width: 16px;
        height: 16px;
        border: 2px solid #000;
        border-radius: 50%;
        margin-right: 5px;
    }

    .margin-text-box {
        margin: 0 10px;
    }

    /* ===== RESPONSIVE DESIGN ===== */
    @@media (max-width: 768px) {
        .main-container {
            padding: 1rem;
        }

        .excel-modal-dialog {
            margin: 1rem;
            width: calc(100% - 2rem);
        }

        .modal-column-grid {
            grid-template-columns: 1fr;
        }

        .excel-modal-body {
            padding: 1rem;
        }

        .upload-zone,
        .upload-zone-clean {
            padding: 1.5rem 1rem;
        }

        .upload-zone h4 {
            font-size: 1.1rem;
        }

        .stat-card-clean {
            padding: 1.5rem;
        }

        .stat-number {
            font-size: 2rem;
        }

        .question-card-clean {
            margin-bottom: 1rem;
        }

        .question-card-clean .p-3 {
            padding: 1rem !important;
        }

        #questionsListContainer {
            max-height: 400px;
            padding: 1rem;
        }

        .alert {
            max-width: 95%;
            font-size: 14px;
        }
    }

    /* ===== CONTAINER CONSTRAINTS ===== */
    .container-fluid {
        max-width: 100%;
        overflow-x: hidden;
    }

    /* ===== VALIDATION STYLES ===== */
    .field-validation-error {
        z-index: auto;
        position: relative;
    }

    /* ===== LOADING OVERLAYS ===== */
    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 1090;
        display: flex;
        justify-content: center;
        align-items: center;
    }
</style>




<div class="main-container">
    <div class="container-fluid">
        <!-- Header -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <h2 class="card-title mb-0">
                            <i class="fas fa-question-circle text-primary me-2"></i>
                            @Localizer["QuestionsBank"] - @Localizer["AddNewQuestion"]
                        </h2>
                        <p class="text-muted mt-2">@Localizer["QuestionsDescription"]</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabs Navigation -->
        <ul class="nav nav-tabs" id="questionTabs" role="tablist">
            <li class="nav-item">
                <a class="nav-link active" id="single-tab" data-toggle="tab" href="#single-question" role="tab">
                    <i class="fas fa-plus me-2"></i>@Localizer["SingleQuestion"]
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="bulk-tab" data-toggle="tab" href="#bulk-import" role="tab">
                    <i class="fas fa-file-excel me-2"></i>@Localizer["BulkImport"]
                </a>
            </li>
        </ul>

        <div class="tab-content" id="questionTabsContent">
            <!-- Single Question Tab -->
            <div class="tab-pane fade show active" id="single-question" role="tabpanel">
                <div class="card">
                    <div class="card-body">
                        <div class="register py-3 p-md-4 h-100" style="overflow-y: auto">
                            <input type="hidden" asp-for="Id" />
                            <div class="mb-2">
                                <!--Drop down list for category-->
                                <div class="form-group">
                                    <label class="requiredLabel">@Localizer["Category"]</label>
                                    <div class="form-row">
                                        <div class="form-group col-md-3">
                                            <select id="ddlCategories" class="form-select w-100" asp-for="CategoryId" asp-items="@(new SelectList(Model.Categories, "Id", IsAr ? "NameAr" : "NameEn"))">
                                                <option value="">@Localizer["Select"]</option>
                                            </select>
                                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                <!--Question text [ Arabic - English ] -->
                                <div class="form-group">
                                    <label class="requiredLabel">@Localizer["QuestionText"]</label>
                                    <div class="form-row">
                                        @if (IsAr)
                                        {
                                            <div class="form-group col-md-4">
                                                <input class="form-control" type="text" asp-for="TextAr" placeholder="@Localizer["InArabic"]" />
                                                <span asp-validation-for="TextAr" class="text-danger"></span>
                                            </div>
                                            <div class="form-group col-md-4">
                                                <input class="form-control" type="text" asp-for="TextEn" placeholder="@Localizer["InEnglish"]" />
                                                <span asp-validation-for="TextEn" class="text-danger"></span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="form-group col-md-4">
                                                <input class="form-control" type="text" asp-for="TextEn" placeholder="@Localizer["InEnglish"]" />
                                                <span asp-validation-for="TextEn" class="text-danger"></span>
                                            </div>
                                            <div class="form-group col-md-4">
                                                <input class="form-control" type="text" asp-for="TextAr" placeholder="@Localizer["InArabic"]" />
                                                <span asp-validation-for="TextAr" class="text-danger"></span>
                                            </div>
                                        }
                                    </div>

                                    <!--If Image for question is exist-->
                                    @{
                                        string imgQuestionPath = !string.IsNullOrEmpty(Model.ImgPath) ? $"data:image/jpeg;base64,{Model.ImgPath}" : "";
                                        string displayedQuestionImg = !string.IsNullOrEmpty(Model.ImgPath) ? "" : "display:none";
                                        string IdOfImg = !string.IsNullOrEmpty(Model.ImgPath) ? Model.Id.Value.ToString() : "";
                                    }
                                    <input type="hidden" id="hdn-curr-img-id" value="@IdOfImg" />
                                    <div class="form-row">
                                        <div class="col-md-3">
                                            <div class="category-box" style="cursor:pointer">
                                                <div class="image-container p-3" id="dv-img-question">
                                                    <img src="@imgQuestionPath" class="w-50" alt="Image" style="@displayedQuestionImg">
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!--File upload for question image -->
                                    <div class="form-row">
                                        <div class="form-group col-md-4 d-flex flex-column d-flex">
                                            <div class="custom-file">
                                                <input type="file" name="Img" class="custom-file-input" id="question-img" style="cursor:pointer" data-answer="2" data-hide="btnDeleteQuestionImg"
                                                       placeholder="@Localizer["ChooseImg"].Value" accept=".jpg, .jpeg, .png">
                                                <label class="custom-file-label upload-btn" for="file">
                                                    <span id="lblQuestionImgName">@Localizer["ChooseImg"]</span>
                                                    <span class="danger"></span> <i id="lblQuestionImgStatus" class="fas fa-upload"></i>
                                                </label>
                                            </div>
                                            <span id="question-Img-invalid" class="text-danger field-validation-error"></span>
                                        </div>

                                        <!-- Button to delete existing image for questions -->
                                        <div class="form-group col-md-4 px-3 m-0" id="dv-btn-delete-image-question" style="@displayedQuestionImg">
                                            <button type="button" id="btnDeleteQuestionImg" onclick="Categories.DeleteExistingImg(2,'dv-img-question',this)" class="btn btn-danger btn-md m-0">
                                                <i class="fas fa-trash"></i>@Localizer["DeleteExistingImage"]
                                            </button>
                                        </div>
                                        <div class="form-group col-md-12" id="dv-delete-question-status" style="display:none">
                                            <div>
                                                <span class="h6 h6-responsive mr-2 ml-0 float-left">
                                                    <i style="display:none" class="fas fa-check-circle text-success i-success-delete-img"></i>
                                                    <i style="display:none" class="fas fa-exclamation-circle text-danger i-error-delete-img"></i>
                                                </span>
                                                <span class="spn-delete-img-status"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Question Type -->
                                <div class="form-group">
                                    <div class="form-row">
                                        <div class="form-group col-md-3">
                                            <label class="requiredLabel">@Localizer["AnswersType"]</label>
                                            <select id="ddlAnswersType" class="form-select w-100" asp-for="AnswertType" style="height:60%">
                                                <option value="1">@Localizer["AnswersTypeText"]</option>
                                                <option value="2">@Localizer["AnswersTypeImg"]</option>
                                            </select>
                                            <span asp-validation-for="AnswertType" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Options Section -->
                            <div class="row mb-3">
                                <label for="Options" class="col-sm-1">@Localizer["Options"]</label>
                            </div>
                            <div class="row mb-3">
                                <!--Asnwers Text-->
                                <div class="col-sm-10 dv-options dv-answers-text">
                                    <div class="option" data-count="1">
                                        <div class="option-row">
                                            <input type="hidden" id="hdn-option-id-1" />
                                            <label class="option-label">
                                                <input class="form-check-input" type="radio" name="correctOption" id="chk-option-1" onchange="Questions.SelectAnswer(this)">
                                            </label>
                                            @if (IsAr)
                                            {
                                                <input class="form-control margin-text-box option-textbox-ar" type="text" id="txt-option-ar-1" placeholder="@Localizer["Option1"] @Localizer["InArabic"]" />
                                                <input class="form-control margin-text-box option-textbox-en" type="text" id="txt-option-en-1" placeholder="@Localizer["Option1"] @Localizer["InEnglish"]" />
                                            }
                                            else
                                            {
                                                <input class="form-control margin-text-box option-textbox-en" type="text" id="txt-option-en-1" placeholder="@Localizer["Option1"] @Localizer["InEnglish"]" />
                                                <input class="form-control margin-text-box option-textbox-ar" type="text" id="txt-option-ar-1" placeholder="@Localizer["Option1"] @Localizer["InArabic"]" />
                                            }
                                            <span class="text-danger field-validation-valid" data-valmsg-replace="true" style="margin:0 20px"></span>
                                        </div>
                                        <div class="option" data-count="2">
                                            <div class="option-row">
                                                <input type="hidden" id="hdn-option-id-2" />
                                                <label class="option-label">
                                                    <input class="form-check-input" type="radio" name="correctOption" id="chk-option-2" onchange="Questions.SelectAnswer(this)">
                                                </label>

                                                @if (IsAr)
                                                {
                                                    <input class="form-control margin-text-box option-textbox-ar" type="text" id="txt-option-ar-2" placeholder="@Localizer["Option2"] @Localizer["InArabic"]" />
                                                    <input class="form-control margin-text-box option-textbox-en" type="text" id="txt-option-en-2" placeholder="@Localizer["Option2"] @Localizer["InEnglish"]" />
                                                }
                                                else
                                                {
                                                    <input class="form-control margin-text-box option-textbox-en" type="text" id="txt-option-en-2" placeholder="@Localizer["Option2"] @Localizer["InEnglish"]" />
                                                    <input class="form-control margin-text-box option-textbox-ar" type="text" id="txt-option-ar-2" placeholder="@Localizer["Option2"] @Localizer["InArabic"]" />
                                                }
                                            </div>
                                            <span class="text-danger field-validation-valid" data-valmsg-replace="true" style="margin:0 20px"></span>
                                        </div>
                                        <div class="option" data-count="3">
                                            <div class="option-row">
                                                <input type="hidden" id="hdn-option-id-3" />
                                                <label class="option-label">
                                                    <input class="form-check-input" type="radio" name="correctOption" id="chk-option-3" onchange="Questions.SelectAnswer(this)">
                                                </label>
                                                @if (IsAr)
                                                {
                                                    <input class="form-control margin-text-box option-textbox-ar" type="text" id="txt-option-ar-3" placeholder="@Localizer["Option3"] @Localizer["InArabic"]" />
                                                    <input class="form-control margin-text-box option-textbox-en" type="text" id="txt-option-en-3" placeholder="@Localizer["Option3"] @Localizer["InEnglish"]" />
                                                }
                                                else
                                                {
                                                    <input class="form-control margin-text-box option-textbox-en" type="text" id="txt-option-en-3" placeholder="@Localizer["Option3"] @Localizer["InEnglish"]" />
                                                    <input class="form-control margin-text-box option-textbox-ar" type="text" id="txt-option-ar-3" placeholder="@Localizer["Option3"] @Localizer["InArabic"]" />
                                                }
                                            </div>
                                            <span class="text-danger field-validation-valid" data-valmsg-replace="true" style="margin:0 20px"></span>
                                        </div>
                                        <div class="option" data-count="4">
                                            <div class="option-row">
                                                <input type="hidden" id="hdn-option-id-4" />
                                                <label class="option-label">
                                                    <input class="form-check-input" type="radio" name="correctOption" id="chk-option-4" onchange="Questions.SelectAnswer(this)">
                                                </label>
                                                @if (IsAr)
                                                {
                                                    <input class="form-control margin-text-box option-textbox-ar" type="text" id="txt-option-ar-4" placeholder="@Localizer["Option4"] @Localizer["InArabic"]" />
                                                    <input class="form-control margin-text-box option-textbox-en" type="text" id="txt-option-en-4" placeholder="@Localizer["Option4"] @Localizer["InEnglish"]" />
                                                }
                                                else
                                                {
                                                    <input class="form-control margin-text-box option-textbox-en" type="text" id="txt-option-en-4" placeholder="@Localizer["Option4"] @Localizer["InEnglish"]" />
                                                    <input class="form-control margin-text-box option-textbox-ar" type="text" id="txt-option-ar-4" placeholder="@Localizer["Option4"] @Localizer["InArabic"]" />
                                                }
                                            </div>
                                        </div>
                                        <span class="text-danger field-validation-valid" data-valmsg-replace="true" style="margin:0 20px;"></span>
                                    </div>
                                </div>


                                <!--Asnwers Image-->
                                <div class="col-sm-10 dv-options dv-answers-images d-none">

                                    @{
                                        int counterAnswers = 4;
                                        int counterModelAnswers = Model.Answers.Count;
                                        bool IsImg = Model.Answers.Any(a => a.IsImg);
                                    }
                                    @for (var i = 0; i < counterAnswers; i++)
                                    {
                                        string mainId = (i + 1).ToString();
                                        string ImgAnswerPath = "";
                                        string displayedAnswerImg = "display:none";
                                        string AnswerImgId = "";
                                        string IsCorrectAnswer = "";
                                        string FileName = Localizer["ChooseImg"].Value;
                                        if (i < counterModelAnswers && IsImg)
                                        {
                                            ImgAnswerPath = Model.Answers[i].ImgPath != null ? $"data:image/jpeg;base64,{Model.Answers[i].ImgPath}" : "";
                                            displayedAnswerImg = !string.IsNullOrEmpty(ImgAnswerPath) ? "" : "display:none";
                                            AnswerImgId = !string.IsNullOrEmpty(ImgAnswerPath) ? Model.Answers[i].Id.Value.ToString() : "";
                                            IsCorrectAnswer = Model.Answers[i].IsAnswer ? "checked=checked" : "";
                                            FileName = !string.IsNullOrEmpty(Model.Answers[i].ImgName) ? Model.Answers[i].ImgName : Localizer["ChooseImg"].Value;
                                        }

                                        <!--Main row for each option-->
                                        <div class="option" data-count="@mainId">

                                            <!--answer- Imgage for option-->
                                            <div class="form-row">
                                                <div class="col-md-3">
                                                    <div class="category-box" style="cursor:pointer" onclick="Questions.SelectAnswerByImage('@mainId')">
                                                        <div class="image-container p-3" id="dv-imgOptionAns-@mainId">
                                                            <img src="@ImgAnswerPath" class="w-50" alt="Image" style="@displayedAnswerImg">
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="option-row">
                                                <!--answer - Radio button to select correct answer-->
                                                <input type="hidden" id="hdn-option-img-id-@mainId" value="@AnswerImgId" />
                                                <label class="option-label">
                                                    <input class="form-check-input" type="radio" name="correctOptionImg" id="chk-option-img-@mainId" @IsCorrectAnswer onchange="Questions.SelectAnswer(this)" style="pointer-events:none">
                                                </label>

                                                <!-- answer - File upload-->
                                                <div class="form-group col-md-4 d-flex flex-column d-flex" style="margin:0 -15px;">
                                                    <div class="custom-file">
                                                        <input type="file" name="Img" class="custom-file-input" id="answer-img-@mainId" style="cursor:pointer" data-answer="@mainId" data-hide="btnDeleteAnsImg-@mainId"
                                                               placeholder="@Localizer["ChooseImg"].Value" accept=".jpg, .jpeg, .png">
                                                        <label class="custom-file-label upload-btn" for="file">
                                                            <span id="lblImageName-@mainId">@FileName</span>
                                                            <span class="danger"></span> <i id="lblImgStatus-@mainId" class="fas fa-upload"></i>
                                                        </label>
                                                    </div>
                                                    <span id="answer-Img-invalid-@mainId" class="text-danger field-validation-error"></span>
                                                </div>


                                                <!--answer If Img is exist, then show button to delete current image answer-->
                                                <div class="form-group col-md-4 m-0" id="dv-btn-delete-image-ans-@mainId" style="@displayedAnswerImg">
                                                    <button type="button" data-id="@mainId" class="btn btn-danger btn-md m-0" id="btnDeleteAnsImg-@mainId" onclick="Categories.DeleteExistingImg(3,'dv-imgOptionAns-@mainId',this)"><i class="fas fa-trash"></i>@Localizer["DeleteImage"]</button>
                                                </div>

                                                <!--answer - Image deleted status-->
                                                <div class="form-group col-md-12 px-3 m-0" id="dv-delete-answer-status-@mainId" style="display:none">
                                                    <span class="h6 h6-responsive mr-2 ml-0 float-left">
                                                        <i style="display:none" class="fas fa-check-circle text-success i-success-delete-img"></i>
                                                        <i style="display:none" class="fas fa-exclamation-circle text-danger i-error-delete-img"></i>
                                                    </span>
                                                    <span class="spn-delete-img-status">
                                                    </span>
                                                </div>
                                            </div>
                                            <span class="text-danger field-validation-valid" data-valmsg-replace="true" style="margin:0 20px"></span>
                                        </div>
                                    }
                                </div>

                                <div class="col-sm-5">
                                    <span class="text-danger field-validation-valid" data-valmsg-for="Answers" id="lbl-generic-error" data-valmsg-replace="true" style="margin:0 20px"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bulk Import Tab -->
            <div class="tab-pane fade" id="bulk-import" role="tabpanel">
                <div class="container-fluid p-0">

                    <!-- Clean Info Note at Top -->
                    <div class="alert alert-info mb-4" id="archivePreview" style="border-radius: 8px; border-left: 4px solid #3b82f6;">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-info-circle me-2" style="color: #3b82f6;"></i>
                            <span>@Localizer["ExcelImportHint"]</span>
                            <button type="button" class="btn btn-link text-primary ml-auto p-0" data-toggle="modal" data-target="#excelTemplateModal">
                                @Localizer["ViewInstructions"]
                            </button>
                        </div>
                    </div>

                    <!-- Category Selection -->
                    <div class="row mb-4">
                        <div class="col-md-4">
                            <label class="form-label font-weight-bold requiredLabel">@Localizer["SelectCategoryForImport"]</label>
                            <select id="ddlBulkCategories" class="form-control">
                                <option value="">@Localizer["Select"]</option>
                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.Id">@(IsAr ? category.NameAr : category.NameEn)</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Clean Upload Zone -->
                    <div class="row">
                        <div class="col-12">
                            <div class="upload-zone-clean" id="uploadZone">
                                <div class="text-center py-5">
                                    <div class="upload-icon-clean mb-3">
                                        <i class="fas fa-cloud-upload-alt fa-3x text-primary"></i>
                                    </div>
                                    <h4 class="text-dark mb-2">@Localizer["DragDropFile"]</h4>
                                    <p class="text-muted mb-0">@Localizer["OrClickToSelect"]</p>
                                    <input type="file" id="excelFile" class="d-none" accept=".xlsx,.xls">
                                    <div class="loading-spinner mt-3" style="display: none;">
                                        <i class="fas fa-spinner fa-spin fa-2x text-primary"></i>
                                        <p class="mt-2 text-muted">@Localizer["ProcessingFile"]</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Clean Statistics Cards -->
                    <div class="row mt-4 d-none" id="statsRow">
                        <div class="col-md-3 mb-3">
                            <div class="stat-card-clean">
                                <div class="stat-number text-primary" id="totalQuestions">0</div>
                                <div class="stat-label">@Localizer["TotalQuestions"]</div>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="stat-card-clean">
                                <div class="stat-number text-success" id="validQuestions">0</div>
                                <div class="stat-label">@Localizer["ValidQuestions"]</div>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="stat-card-clean">
                                <div class="stat-number text-warning" id="warningQuestions">0</div>
                                <div class="stat-label">@Localizer["WithWarnings"]</div>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="stat-card-clean">
                                <div class="stat-number text-danger" id="invalidQuestions">0</div>
                                <div class="stat-label">@Localizer["InvalidQuestions"]</div>
                            </div>
                        </div>
                    </div>

                    <!-- Clean Questions Container -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="card border-0 shadow-sm questions-container-enhanced d-none" id="questionsContainer">
                                <div class="questions-header-enhanced">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                                        <h5 class="mb-0 text-dark">
                                            <i class="fas fa-list me-2 text-primary"></i><span id="questionsTitle">@Localizer["ImportedQuestions"]</span>
                                        </h5>
                                        <div class="btn-group" role="group">
                                            <button class="btn btn-outline-primary btn-sm" id="selectAllQuestions">
                                                <i class="fas fa-check-square me-1"></i><span id="selectAllText">@Localizer["SelectAll"]</span>
                                            </button>
                                            <button class="btn btn-primary btn-sm" id="saveSelectedQuestions">
                                                <i class="fas fa-save me-1"></i><span id="saveSelectedText">@Localizer["SaveSelected"]</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body p-0">
                                    <div id="questionsListContainer">
                                        <!-- Questions will be dynamically inserted here -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <!-- Excel Template Helper Modal -->
            <div class="modal fade excel-modal" id="excelTemplateModal" tabindex="-1" style="z-index: 1100 !important;">
                <div class="modal-dialog excel-modal-dialog">
                    <div class="modal-content excel-modal-content">
                        <div class="modal-header excel-modal-header">
                            <h4 class="modal-title" id="excelTemplateModalLabel">
                                <i class="fas fa-file-excel me-2"></i>
                                @Localizer["ExcelImportGuide"]
                            </h4>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="@Localizer["Close"]"></button>
                        </div>
                        <div class="modal-body excel-modal-body">
                            <!-- Column Description -->
                            <div class="mb-4">
                                <h5 class="mb-3">📋 @Localizer["RequiredExcelColumns"]</h5>
                                <div class="modal-column-grid">
                                    <div class="modal-column-item">
                                        <div class="modal-column-name">@Localizer["QuestionEnglish"]</div>
                                        <div class="modal-column-desc">@Localizer["QuestionEnglishDesc"]</div>
                                    </div>
                                    <div class="modal-column-item">
                                        <div class="modal-column-name">@Localizer["QuestionArabic"]</div>
                                        <div class="modal-column-desc">@Localizer["QuestionArabicDesc"]</div>
                                    </div>
                                    <div class="modal-column-item">
                                        <div class="modal-column-name">@Localizer["Option1"] @Localizer["InArabic"] / @Localizer["InEnglish"]</div>
                                        <div class="modal-column-desc">@Localizer["Option1Desc"]</div>
                                    </div>
                                    <div class="modal-column-item">
                                        <div class="modal-column-name">@Localizer["Option2"] @Localizer["InArabic"] / @Localizer["InEnglish"]</div>
                                        <div class="modal-column-desc">@Localizer["Option2Desc"]</div>
                                    </div>
                                    <div class="modal-column-item">
                                        <div class="modal-column-name">@Localizer["Option3"] @Localizer["InArabic"] / @Localizer["InEnglish"]</div>
                                        <div class="modal-column-desc">@Localizer["Option3Desc"]</div>
                                    </div>
                                    <div class="modal-column-item">
                                        <div class="modal-column-name">@Localizer["Option4"] @Localizer["InArabic"] / @Localizer["InEnglish"]</div>
                                        <div class="modal-column-desc">@Localizer["Option4Desc"]</div>
                                    </div>
                                    <div class="modal-column-item">
                                        <div class="modal-column-name">@Localizer["CorrectAnswer"]</div>
                                        <div class="modal-column-desc">@Localizer["CorrectAnswerDesc"]</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Sample Data Preview -->
                            <div class="mb-4">
                                <h5 class="mb-3">📖 @Localizer["SampleDataPreview"]</h5>
                                <div style="overflow-x: auto;">
                                    <table class="modal-preview-table">
                                        <thead>
                                            <tr>
                                                <th>@Localizer["QuestionEnglish"]</th>
                                                <th>@Localizer["QuestionArabic"]</th>
                                                <th>@Localizer["Option1"] @Localizer["InEnglish"]</th>
                                                <th>@Localizer["Option1"] @Localizer["InArabic"]</th>
                                                <th>@Localizer["Option2"] @Localizer["InEnglish"]</th>
                                                <th>@Localizer["Option2"] @Localizer["InArabic"]</th>
                                                <th>@Localizer["Option3"] @Localizer["InEnglish"]</th>
                                                <th>@Localizer["Option3"] @Localizer["InArabic"]</th>
                                                <th>@Localizer["CorrectAnswer"]</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>What is the capital of France?</td>
                                                <td>ما هي عاصمة فرنسا؟</td>
                                                <td>London</td>
                                                <td>لندن</td>
                                                <td>Berlin</td>
                                                <td>برلين</td>
                                                <td>Paris</td>
                                                <td>باريس</td>
                                                <td>3</td>
                                            </tr>
                                            <tr>
                                                <td>Which planet is closest to the Sun?</td>
                                                <td>أي كوكب أقرب إلى الشمس؟</td>
                                                <td>Venus</td>
                                                <td>الزهرة</td>
                                                <td>Mercury</td>
                                                <td>عطارد</td>
                                                <td>Earth</td>
                                                <td>الأرض</td>
                                                <td>2</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Important Rules -->
                            <div class="modal-alert-warning">
                                <strong>⚠️ @Localizer["ImportantRules"]</strong>
                                <ul>
                                    <li>@Localizer["RuleQuestionRequired"]</li>
                                    <li>@Localizer["RuleMinimumOptions"]</li>
                                    <li>@Localizer["RuleCorrectAnswerRange"]</li>
                                    <li>@Localizer["RuleCorrectAnswerNotEmpty"]</li>
                                    <li>@Localizer["RuleColumnCaseSensitive"]</li>
                                </ul>
                            </div>

                            <!-- Tips -->
                            <div class="modal-alert-success">
