                                    <li>@Localizer["TipFillRowByRow"]</li>
                                    <li>@Localizer["TipCorrectAnswerMatch"]</li>
                                    <li>@Localizer["TipOptionalOptions"]</li>
                                    <li>@Localizer["TipSaveFormat"]</li>
                                </ul>
                            </div>

                            <!-- Download Section -->
                            <div class="text-center mb-4">
                                <h5 class="mb-3">📥 @Localizer["DownloadSampleFiles"]</h5>
                                <a href="@Url.Action("DownloadExcelTemplate", "Questions")" class="download-btn" target="_blank">
                                    <i class="fas fa-download ml-2 mr-2"></i>@Localizer["DownloadAdvancedTemplate"]
                                </a>
                            </div>
                        </div>
                        <div class="modal-footer excel-modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick="Categories.BulkImport.CloseBulkModal()">
                                <i class="fas fa-times me-1 ml-2 mr-2"></i>@Localizer["Close"]
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Save Buttons -->
        <div class="row mt-4">
            <div class="col-12 text-center">
                <button type="button" class="btn btn-primary" onclick="Questions.AddNewQuestion()">@Localizer["Save"]</button>
                <button type="button" class="btn btn-secondary" onclick="window.location.href='@Url.Action("AddCategory", "Questions",new { id = Model.CategoryId })';">@Localizer["Cancel"]</button>
                @if (Model.Id.HasValue && userInfoDTO.PermissionCodes.Contains(PermissionCodes.WebQuestionsDelete))
                {
                    <button type="button" onclick="Questions.DeleteQuestion(this)" data-category="@Model.CategoryId" id="btndelete_@Model.Id" class="btn btn-danger">@Localizer["Delete"]</button>
                }
            </div>
        </div>
    </div>
</div>


