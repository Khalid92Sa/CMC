@model CMC.Presentation.Application.DTOs.Players.PlayerDTO

@using Microsoft.AspNetCore.Http;
@using CMC.Kernel.Core.Constants
@using CMC.Presentation.Application.DTOs.Identity
@using Newtonsoft.Json
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = Model.Id.HasValue ? Localizer["EditPlayer"].Value : Localizer["AddPlayer"].Value;
    bool IsAr = Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName == "ar";
    UserDTO userInfoDTO = HttpContextAccessor.HttpContext.Session.GetString("UserInfoDTO") != null ?
       JsonConvert.DeserializeObject<UserDTO>(HttpContextAccessor.HttpContext.Session.GetString("UserInfoDTO")) : null;
}

<style>
    .profile-picture-box {
        border: 1px solid #ddd;
        padding: 20px;
        text-align: center;
        margin-bottom: 20px;
        width: 200px;
        height: 200px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        background-color: #f8f9fa;
        border-radius: 8px;
    }

        .profile-picture-box .image-container {
            width: 100%;
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

            .profile-picture-box .image-container img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                border-radius: 8px;
            }
</style>

<form method="post" id="form-player" enctype="multipart/form-data" asp-controller="Players" asp-action="CreatePlayer">
    <div class="flex flex-column justify-content-center align-items-center">
        <div class="row justify-content-between">
            <div class="col-12 d-flex flex-row justify-content-between">
                @if (Model.Id.HasValue)
                {
                    <h6 class="justify-content-start align-middle align-self-center mb-3">@Localizer["EditPlayer"] : @Model.Name </h6>
                }
                else
                {
                    <h6 class="justify-content-start align-middle align-self-center mb-3">@Localizer["AddPlayer"]</h6>
                }
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <div class="register py-3 p-md-4 h-100" style="overflow-y: auto">
                    <input type="hidden" asp-for="Id" />

                    <!-- Profile Picture Section -->
                    <div class="mb-4">
                        <div class="form-group">
                            <label class="">@Localizer["ProfilePicture"]</label>
                            <div class="form-row">
                                <!-- Profile Picture Preview -->
                                <div class="col-md-3">
                                    @{
                                        string imgProfilePath = !string.IsNullOrEmpty(Model.ProfilePicturePath) ? $"data:image/jpeg;base64,{Model.ProfilePicturePath}" : "";
                                        string displayedProfileImg = !string.IsNullOrEmpty(Model.ProfilePicturePath) ? "" : "display:none";
                                        string IdOfImg = !string.IsNullOrEmpty(Model.ProfilePicturePath) ? Model.Id.Value.ToString() : "";
                                    }
                                    <input type="hidden" id="hdn-curr-profile-img-id" value="@IdOfImg" />

                                    <div class="profile-picture-box" style="cursor:pointer">
                                        <div class="image-container p-3" id="dv-img-profile">
                                            <img src="@imgProfilePath" class="w-50" alt="Profile Picture" style="@displayedProfileImg">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- File upload for profile picture -->
                            <div class="form-row">
                                <div class="form-group col-md-4 d-flex flex-column d-flex">
                                    <div class="custom-file">
                                        <input type="file" name="ProfilePicture" class="custom-file-input" id="profile-picture"
                                               style="cursor:pointer" data-answer="profile" data-hide="btnDeleteProfileImg"
                                               placeholder="@Localizer["ChooseImg"].Value" accept=".jpg, .jpeg, .png">
                                        <label class="custom-file-label upload-btn" for="file">
                                            <span id="lblProfileImgName">@Localizer["ChooseImg"]</span>
                                            <span class="danger"></span> <i id="lblProfileImgStatus" class="fas fa-upload"></i>
                                        </label>
                                    </div>
                                    <span id="profile-picture-invalid" class="text-danger field-validation-error"></span>
                                </div>

                                <!-- Button to delete existing profile picture -->
                                <div class="form-group col-md-4 px-3 m-0" id="dv-btn-delete-profile-image" style="@displayedProfileImg">
                                    <button type="button" id="btnDeleteProfileImg" onclick="Players.DeleteExistingProfileImg(4,'dv-img-profile',this)" class="btn btn-danger btn-md m-0">
                                        <i class="fas fa-trash"></i>@Localizer["DeleteExistingImage"]
                                    </button>
                                </div>

                                <div class="form-group col-md-12" id="dv-delete-profile-status" style="display:none">
                                    <div>
                                        <span class="h6 h6-responsive mr-2 ml-0 float-left">
                                            <i style="display:none" class="fas fa-check-circle text-success i-success-delete-img"></i>
                                            <i style="display:none" class="fas fa-exclamation-circle text-danger i-error-delete-img"></i>
                                        </span>
                                        <span class="spn-delete-img-status"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>



                    <div class="mb-2">
                        <div class="form-group">
                            <div class="form-row">
                                <div class="form-group col-md-3">
                                    <label class="requiredLabel">@Localizer["PlayerName"]</label>
                                    <input class="form-control" type="text" asp-for="Name" autocomplete="off" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-3">
                                    <label class="requiredLabel">@Localizer["MobileNumber"]</label>
                                    <input class="form-control" type="text" asp-for="PhoneNumber" onkeypress="return GeneralClass.validationNumbersOnly(this,event)" autocomplete="off" />
                                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="mb-2">
                        <div class="form-row">
                            <div class="form-group col-md-3">
                                <label class="">@Localizer["EmailAddress"]</label>
                                <input class="form-control" type="text" asp-for="EmailAddress" autocomplete="off" />
                                <span asp-validation-for="EmailAddress" class="text-danger"></span>
                            </div>
                            <div class="form-group col-12 col-md-3 pt-4">
                                <div class="custom-control custom-checkbox" style="margin-top: 9px">
                                    <input type="checkbox" asp-for="IsEmployee" class="custom-control-input" />
                                    <label class="custom-control-label pt-1" for="IsEmployee">@Localizer["CityMallEmployees"]</label>
                                </div>
                            </div>
                            <div class="form-group col-12 col-md-3 pt-4">
                                <div class="custom-control custom-checkbox" style="margin-top: 9px">
                                    <input type="checkbox" asp-for="IsBlocked" class="custom-control-input" />
                                    <label class="custom-control-label pt-1" for="IsBlocked">@Localizer["Blocked"]</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="mb-2">
                        <div class="form-row">
                            <div class="form-group col-md-3">
                                <label class="">@Localizer["Comment"]</label>
                                <textarea class="form-control" type="text" asp-for="Comment" rows="3"></textarea>
                                <span asp-validation-for="Comment" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 text-center">
                        <button type="button" class="btn btn-primary" onclick="Players.CreateOrUpdate()">@Localizer["Save"]</button>
                        <button type="button" class="btn btn-secondary" onclick="window.location.href='@Url.Action("Index", "Players")';">@Localizer["Cancel"]</button>
                        @if (Model.Id.HasValue && userInfoDTO.PermissionCodes.Contains(PermissionCodes.WebPlayerDelete))
                        {
                            <button type="button" class="btn btn-danger" id="btndelete_@Model.Id" onclick="Players.DeletePlayer(this)">@Localizer["Delete"]</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<!-- end row -->
<script src="~/assets/js/Application/Players.js"></script>

<script>
    Players.HandleProfilePictureUpload();
    GeneralClass.ActivationSubMenuItem('#lnkPlayers', '#lnkPlayers');
    GeneralClass.ActivationSubMenuItem('#lnkPlayers2', '#lnkPlayers2');
</script>