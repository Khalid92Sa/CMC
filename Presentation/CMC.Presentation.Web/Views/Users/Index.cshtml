@using Microsoft.AspNetCore.Http;
@using Microsoft.AspNetCore.Mvc;
@using System.Globalization;
@using System.Threading
@using CMC.Kernel.Core.Constants
@using CMC.Presentation.Application.DTOs.Identity
@using Newtonsoft.Json
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = Localizer["UsersIndexTitle"].Value;
    bool IsAr = Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName == "ar";
    UserDTO userInfoDTO = HttpContextAccessor.HttpContext.Session.GetString("UserInfoDTO") != null ?
       JsonConvert.DeserializeObject<UserDTO>(HttpContextAccessor.HttpContext.Session.GetString("UserInfoDTO")) : null;
}

<div class="flex flex-column justify-content-center align-items-center">
    <div class="row d-flex align-items-center justify-content-between mb-3">
        <div class="col-5">
            <h6 class="mb-0">@Localizer["UsersIndexTitle"]</h6>
        </div>
        <div class="col-5">
            @if (userInfoDTO.PermissionCodes.Contains(PermissionCodes.WebUsersAdd))
            {
                <div class="formBtn d-flex justify-content-end">
                    <a href="@Url.Action("AddUser","Users")" style="white-space:nowrap;" class="btn btn-outline-primary mx-0">@Localizer["AddUser"]</a>
                </div>
            }
        </div>
    </div>
    <div class="card">
        <div class="card-body">
            <div class="form-row mb-3 filter">
                <div class="form-group col-md-3 pr-md-2 m-0">
                    <label class="d-block">@Localizer["Name"]</label>
                    <input type="text" id="txtName" class="form-control d-inline-block" />
                </div>
                <div class="form-group col-md-3 px-md-2 m-0 pt-3 pt-md-0">
                    <label class="d-block">@Localizer["MobileNumber"]</label>
                    <input type="text" id="txtPhoneNumber" class="form-control d-inline-block" onkeypress="return GeneralClass.validationNumbersOnly(this,event)" />
                </div>
                <div class="form-group col-md-2 px-md-2 m-0 pt-3 pt-md-0">
                    <label class="d-block">@Localizer["Groups"]</label>
                    <select class="form-control" id="ddlGroups">
                        <option value="">@Localizer["All"]</option>
                        @foreach (var group in ViewBag.Groups)
                        {
                            string groupName = IsAr ? group.NameAr : group.NameEn;
                            <option value="@group.Id">@groupName</option>
                        }
                    </select>
                </div>
                <div class="form-group col-md-auto px-md-2 m-0 text-left">
                    <button id="btnSearch" class="btn btn-primary rounded">@Localizer["Search"]</button>
                </div>
            </div>
            <div class="from-row mb-3">
                <table id="tblUsers" class="table table-sm table-striped NoPagenation">
                    <thead>
                        <tr>
                            <th scope="col" style="width:70px;">#</th>
                            <th scope="col">@Localizer["Name"]</th>
                            <th scope="col">@Localizer["MobileNumber"]</th>
                            <th scope="col">@Localizer["EmailAddress"]</th>
                            <th scope="col">@Localizer["Group"]</th>
                            <th scope="col">@Localizer["UserStatus"]</th>
                            <th scope="col"></th>
                        </tr>
                    </thead>
                </table>
            </div>
            <div class="form-row justify-content-end">
                <div class="pt-2 mr-3">
                    <span id="pagerInfo">
                    </span>
                </div>
                <div id="pager" class="site-pagination">
                    <ul id="pagination" class="pagination justify-content-end mb-0"></ul>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="modalConfirmActivation" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content p-4">
            <div class="modal-body text-center">
                <input type="hidden" id="UserId" />
                <input type="hidden" id="IsActive" />
                <h5 id="ConfirmActivationMessage">
                    @Localizer["Message_ActivationCancel"]
                </h5>
            </div>
            <div class="modal-footer justify-content-center p-0 border-0">
                <button onclick="Users.ActivateUser()" class="btn btn-primary">@Localizer["Common_Yes"]</button>
                <button type="button" class="btn btn-secondary" data-dismiss="modal">@Localizer["Common_No"]</button>
            </div>
        </div>
    </div>
</div>

<script src="~/assets/js/Application/Users.js"></script>
<script>
    Users.OnLoad();
    GeneralClass.ActivationSubMenuItem('#lnkSystemMangement', '#lnkUsers');
    GeneralClass.ActivationSubMenuItem('#lnkSystemMangement2', '#lnkUsers2');
    var CanDelete = '@ViewData["CanDelete"]' == 'True';
    var CanCreate = '@ViewData["CanCreate"]' == 'True';
</script>
