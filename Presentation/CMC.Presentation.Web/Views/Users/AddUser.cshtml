@model CMC.Presentation.Application.DTOs.Identity.UserDTO
@{
    ViewData["Title"] = Model.Id.HasValue ? Localizer["EditUser"].Value : Localizer["AddUser"].Value;
    bool IsAr = Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName == "ar";
}

<form method="post" id="form-user" enctype="multipart/form-data" asp-controller="Users" asp-action="AddUser">
    <div class="flex flex-column justify-content-center align-items-center">
        <div class="row justify-content-between">
            <div class="col-12 d-flex flex-row justify-content-between">
                @if (Model.Id.HasValue)
                {
                    <h6 class="justify-content-start align-middle align-self-center mb-3">@Localizer["EditUser"] : @Model.Name </h6>
                }
                else
                {
                    <h6 class="justify-content-start align-middle align-self-center mb-3">@Localizer["AddUser"]</h6>
                }
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <div class="register py-3 p-md-4 h-100" style="overflow-y: auto">
                    <input type="hidden" asp-for="Id" />
                    <div class="mb-2">
                        <div class="form-group">
                            <div class="form-row">
                                <div class="form-group col-md-3">
                                    <label class="requiredLabel">@Localizer["Name"]</label>
                                    <input class="form-control" type="text" asp-for="Name" autocomplete="off" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-3">
                                    <label class="requiredLabel">@Localizer["MobileNumber"]</label>
                                    <input class="form-control" type="text" asp-for="PhoneNumber" autocomplete="off" onkeypress="return GeneralClass.validationNumbersOnly(this,event)" />
                                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="mb-2">
                        <div class="form-row">
                            <div class="form-group col-md-3">
                                <label class="requiredLabel">@Localizer["EmailAddress"]</label>
                                <input class="form-control" type="text" asp-for="EmailAddress" autocomplete="off" />
                                <span asp-validation-for="EmailAddress" class="text-danger"></span>
                            </div>
                            @if (!Model.Id.HasValue)
                            {
                                <div class="form-group col-md-3">
                                    <label class="requiredLabel">@Localizer["Username"]</label>
                                    <input class="form-control" type="text" asp-for="UserName" autocomplete="off" />
                                    <span asp-validation-for="UserName" class="text-danger"></span>
                                </div>
                            }
                            <div class="form-group col-md-3 pt-2">
                                <label class="">@Localizer["Groups"]</label>
                                <select id="ddlGroups" class="form-select w-100" asp-for="GroupId" asp-items="@(new SelectList(Model.Groups, "Id", IsAr ? "NameAr" : "NameEn"))">
                                    <option value="">@Localizer["Select"]</option>
                                </select>
                                <span asp-validation-for="GroupId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 text-center">
                        <button type="button" class="btn btn-primary" onclick="Users.CreateOrUpdate()">@Localizer["Save"]</button>
                        <button type="button" class="btn btn-secondary" onclick="window.location.href='@Url.Action("Index", "Users")';">@Localizer["Cancel"]</button>
                        @if (Model.Id.HasValue)
                        {
                            <button type="button" class="btn btn-danger" onclick="Users.DeleteUsers()">@Localizer["Delete"]</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>