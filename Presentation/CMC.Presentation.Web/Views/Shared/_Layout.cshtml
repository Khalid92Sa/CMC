@using Microsoft.AspNetCore.Http;
@using Microsoft.AspNetCore.Mvc;
@using System.Globalization;
@using System.Threading
@using CMC.Kernel.Core.Constants
@using CMC.Presentation.Application.DTOs.Identity
@using Newtonsoft.Json


@inject IHttpContextAccessor HttpContextAccessor


@{
    bool IsAr = Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName == "ar";
    var returnUrl = string.IsNullOrEmpty(Context.Request.Path) ? "~/" : $"~{Context.Request.Path.Value}{Context.Request.QueryString}";
    string direction = IsAr ? "dir=rtl" : "";
    string baseURL = configuration.GetValue<string>("BaseURL");
    string Title = ViewBag.Title != null ? ViewBag.Title : Localizer["LayoutTitle"].Value;
    UserDTO userInfoDTO = HttpContextAccessor.HttpContext.Session.GetString("UserInfoDTO") != null ?
        JsonConvert.DeserializeObject<UserDTO>(HttpContextAccessor.HttpContext.Session.GetString("UserInfoDTO")) : null;
}



<!DOCTYPE html>
<html lang="en" @direction>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Title</title>
    <meta content="@Title" name="description" />

    @if (IsAr)
    {
        //Arabic Styles
        <link type="text/css" rel="stylesheet" href="~/assets/shared/select2/css/select2.min.rtl.css" />
        <link type="text/css" rel="stylesheet" href="~/assets/js/calender/jquery.calendars.picker.css" />
        <link type="text/css" rel="stylesheet" href="~/assets/shared/bootstrap/css/bootstrap.min.rtl.css" />
        <link type="text/css" rel="stylesheet" href="~/assets/shared/MDB-Free_4.8.0/css/mdb.min.rtl.css" />
        <link type="text/css" rel="stylesheet" href="~/assets/shared/MDB-Free_4.8.0/css/addons/datatables.min.rtl.css">
        <link type="text/css" rel="stylesheet" href="~/assets/shared/MDB-Free_4.8.0/css/addons/datatables-select.min.rtl.css">
        <link type="text/css" rel="stylesheet" href="~/assets/shared/font-awesome-5.1/css/all.min.css" />
        <link type="text/css" rel="stylesheet" href="~/assets/SignalR/toastr.css" />
        <link type="text/css" rel="stylesheet" href="~/assets/css/main.rtl.css" />
    }
    else
    {
        //English Styles
        <link type="text/css" rel="stylesheet" href="~/assets/shared/select2/css/select2.min.css" />
        <link type="text/css" rel="stylesheet" href="~/assets/js/calender/jquery.calendars.picker.css" />
        <link type="text/css" rel="stylesheet" href="~/assets/shared/bootstrap/css/bootstrap.min.css" />
        <link type="text/css" rel="stylesheet" href="~/assets/shared/MDB-Free_4.8.0/css/mdb.min.css" />
        <link type="text/css" rel="stylesheet" href="~/assets/shared/MDB-Free_4.8.0/css/addons/datatables.min.css">
        <link type="text/css" rel="stylesheet" href="~/assets/shared/MDB-Free_4.8.0/css/addons/datatables-select.min.css">
        <link type="text/css" rel="stylesheet" href="~/assets/shared/font-awesome-5.1/css/all.min.css" />
        <link type="text/css" rel="stylesheet" href="~/assets/SignalR/toastr.css" />
        <link type="text/css" rel="stylesheet" href="~/assets/css/main.css" />
    }

    <script>
        var generalSettings = {
            pageSize: '@PaginationSettings.PageSize',
            BaseURL: '@baseURL'
        };

    </script>
    <link type="text/css" rel="stylesheet" href="~/assets/shared/sweetalert2/sweetalert2.min.css" />

    <script type="text/javascript" src="~/assets/js/jquery-3.5.1.min.js"></script>
    <script type="text/javascript" src="~/assets/js/utils.js"></script>
    <script type="text/javascript" src="~/assets/js/tether.min.js"></script>
    <script type="text/javascript" src="~/assets/js/popper.js"></script>
    <script type="text/javascript" src="~/assets/shared/bootstrap/js/bootstrap.min.js"></script>
    <script type="text/javascript" src="~/assets/shared/font-awesome-5.1/js/all.min.js"></script>
    <script type="text/javascript" src="~/assets/shared/sweetalert2/sweetalert2.min.js"></script>
    <script type="text/javascript" src="~/assets/js/scripts.js"></script>
    <script type="text/javascript" src="~/assets/js/calender/jquery.calendars.js"></script>
    <script type="text/javascript" src="~/assets/js/calender/jquery.calendars.plus.js"></script>
    <script type="text/javascript" src="~/assets/js/calender/jquery.calendars.ummalqura.js"></script>
    @if (IsAr)
    {
        <script type="text/javascript" src="~/assets/js/calender/jquery.calendars.picker.js"></script>
        <script type="text/javascript" src="~/assets/js/calender/jquery.calendars-ar-EG.js"></script>
        <script type="text/javascript" src="~/assets/js/calender/jquery.calendars.ummalqura-ar.js"></script>
    }
    else
    {
        <script type="text/javascript" src="~/assets/js/calender/jquery.calendars.picker-en.js"></script>
        <script type="text/javascript" src="~/assets/js/calender/jquery.calendars-en-US.js"></script>
        <script type="text/javascript" src="~/assets/js/calender/jquery.calendars.ummalqura-en.js"></script>
    }


    <script type="text/javascript" src="~/assets/js/jquery.validate.min.js"></script>
    <script type="text/javascript" src="~/assets/js/jquery.validate.unobtrusive.min.js"></script>
    <!--SignalR-->
    <script type="text/javascript" src="~/assets/SignalR/toastr.js"></script>
    <script type="text/javascript" src="~/assets/js/jquery.signalR-2.2.1.min.js"></script>
    <script type="text/javascript" src="~/assets/shared/select2/js/select2.min.js"></script>
    <script type="text/javascript" src="~/assets/shared/MDB-Free_4.8.0/js/addons/datatables.min.js"></script>
    <script type="text/javascript" src="~/assets/shared/mdb-free_4.8.0/js/addons/jquery.twbspagination.min.js"></script>
    <script type="text/javascript" src="~/assets/js/helper/apihelper.js"></script>
    <script type="text/javascript" src="~/assets/js/helper/grid.js"></script>
    <script type="text/javascript" src="~/assets/js/Application/GeneralClass.js"></script>
    <script type="text/javascript" src="~/assets/js/Application/Users.js"></script>

    <style>
        .input-validation-error {
            background: pink;
            border: 1px solid red;
        }

        .alert {
            z-index: 2000 !important;
        }
    </style>
</head>
<body class="admin">
    <div id="alert-error" class="alert alert-danger" role="alert" style="display:none">
        @Localizer["ErrorOccurred"]
    </div>
    <input type="hidden" value="@returnUrl" id="hdnReturnedUrl" />
    <nav id="navbar" class="navbar fixed-top navbar-light navbar-expand-lg NavMobile">
        <div class="container-fluid d-flex align-items-center">
            <a class="navbar-brand animated fadeInLeft d-flex justify-content-center py-md-3" href="@Url.Action("Index", "Dashboard")">
                <img class="img-ar" src="~/assets/images/logos/logo-dark.png" style="width:100px;">
                <img class="img-en" src="~/assets/images/logos/logo-dark.png" style="width:100px;">
            </a>
            <div class="d-flex">
                <ul class="navbar-nav align-items-center justify-content-sm-end justify-content-md-end d-flex d-lg-none">
                    <li class="nav-item">
                        <partial name="../Shared/_Language.cshtml" />
                    </li>
                </ul>
                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>
            <div class="collapse navbar-collapse animated fadeInDown justify-content-lg-end justify-content-center menu-responsive" id="navbarSupportedContent">
                <div class="row py-3 d-flex justify-content-center">
                    <div class="col-12 border-bottom d-flex justify-content-lg-start">
                        <ul class="navbar-nav align-items-center align-items-md-center justify-content-sm-center justify-content-md-start">
                            @if (userInfoDTO != null)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="#">
                                        @Localizer["Menu_Hello"] <span class="TextHighlight font-weight-bold primary-color">
                                            @userInfoDTO.Name
                                        </span> !
                                    </a>
                                </li>
                            }

                            <li class="nav-item d-none d-lg-flex">
                                @if (userInfoDTO != null && !string.IsNullOrEmpty(HttpContextAccessor.HttpContext.Session.GetString("UserId")))
                                {
                                    <a class="nav-link" href="@Url.Action("Logout","Users")">@Localizer["Logout"]</a>
                                }
                            </li>
                            <li class="nav-item d-none d-lg-flex">
                                <partial name="../Shared/_Language.cshtml" />
                            </li>
                        </ul>
                    </div>
                    <div class="col-12 px-0 ml-0">
                        <ul class="nav flex-column d-flex d-lg-none">
                            <li>
                                <a href="@(Url.Action("Index" , "Home"))" id="lnkMainPage" class="nav-link"><i class="fas fa-home"></i>@Localizer["Menu_MainPage"]</a>
                            </li>
                            @if (userInfoDTO.PermissionCodes.Contains(PermissionCodes.SystemSettings) || userInfoDTO.PermissionCodes.Contains(PermissionCodes.WebUsersView))
                            {
                                <li>
                                    <a class="nav-link dropdown-toggle collapsed" id="lnkSystemMangement" href="#SystemMangement" data-toggle="collapse" aria-expanded="false">
                                        <i class="fas fa-cog"></i> @Localizer["Menu_SystemManagement"]
                                    </a>
                                    <ul class="list-unstyled collapse" id="SystemMangement">
                                        @if (userInfoDTO.PermissionCodes.Contains(PermissionCodes.WebUsersView))
                                        {
                                            <li>
                                                <a class="nav-link text-primary pl-5" id="lnkUsers" href="@Url.Action("Index", "Users")">@Localizer["Menu_UsersAccountsManagement"]</a>
                                            </li>
                                        }
                                        @if (userInfoDTO.PermissionCodes.Contains(PermissionCodes.SystemSettings))
                                        {
                                            <li>
                                                <a class="nav-link text-primary pl-5" id="lnkSettings" href="@Url.Action("Index", "Settings")">@Localizer["Menu_Settings"]</a>
                                            </li>
                                        }
                                    </ul>
                                </li>
                            }
                            @if (userInfoDTO.PermissionCodes.Contains(PermissionCodes.WebCompetitionView))
                            {
                                <li>
                                    <a href="@(Url.Action("Index" , "Competitions"))" id="lnkCompetitions" class="nav-link"><i class="fas fa-home"></i>@Localizer["Competitions"]</a>
                                </li>
                            }
                            @if (userInfoDTO.PermissionCodes.Contains(PermissionCodes.WebQuestionsView) || userInfoDTO.PermissionCodes.Contains(PermissionCodes.WebQuestionsCreate))
                            {
                                <li>
                                    <a class="nav-link dropdown-toggle collapsed" id="lnkQuestions" href="#Questions" data-toggle="collapse" aria-expanded="false">
                                        <i class="fas fa-question-circle"></i> @Localizer["QuestionsBank"]
                                    </a>
                                    <ul class="list-unstyled collapse" id="Questions">
                                        @if (userInfoDTO.PermissionCodes.Contains(PermissionCodes.WebQuestionsView))
                                        {
                                            <li>
                                                <a class="nav-link text-primary pl-5" id="lnkQuestionCategory" href="@Url.Action("Index", "Questions")">@Localizer["QuestionCategory"]</a>
                                            </li>
                                        }
                                        @if (userInfoDTO.PermissionCodes.Contains(PermissionCodes.WebQuestionsCreate))
                                        {
                                            <li>
                                                <a class="nav-link text-primary pl-5" id="lnkQuestionAdd" href="@Url.Action("AddQuestion", "Questions")">@Localizer["AddQuestions"]</a>
                                            </li>
                                        }
                                    </ul>
                                </li>
                            }
                            @if (userInfoDTO.PermissionCodes.Contains(PermissionCodes.WebPlayerView))
                            {
                                <li>
                                    <a href="@(Url.Action("Index" , "Players"))" id="lnkPlayers" class="nav-link"><i class="fas fa-users"></i>@Localizer["Players"]</a>
                                </li>
                            }
                            <li class="">
                                <a href="@(Url.Action("Profile" , "Users"))" id="lnkProfile" class="nav-link"><i class="fas fa-home"></i>@Localizer["Menu_Profile"]</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </nav>
    <div class="container-fluid h-100" style="overflow-y: auto;overflow-x: hidden;">
        <div class="row">
            <div class="col-12 col-lg-auto side-menu d-none d-lg-block">
                <!--side menu-->
                <ul class="nav flex-column">
                    <li>
                        <a href="@(Url.Action("Index" , "Home"))" id="lnkMainPage2" class="nav-link"><i class="fas fa-home"></i>@Localizer["Menu_MainPage"]</a>
                    </li>
                    @if (userInfoDTO.PermissionCodes.Contains(PermissionCodes.SystemSettings) || userInfoDTO.PermissionCodes.Contains(PermissionCodes.WebUsersView))
                    {
                        <li>
                            <a class="nav-link dropdown-toggle collapsed" id="lnkSystemMangement2" href="#SystemMangement" data-toggle="collapse" aria-expanded="false">
                                <i class="fas fa-cog"></i> @Localizer["Menu_SystemManagement"]
                            </a>
                            <ul class="list-unstyled collapse" id="SystemMangement">
                                @if (userInfoDTO.PermissionCodes.Contains(PermissionCodes.WebUsersView))
                                {
                                    <li>
                                        <a class="nav-link text-primary pl-5" id="lnkUsers2" href="@Url.Action("Index", "Users")">@Localizer["Menu_UsersAccountsManagement"]</a>
                                    </li>
                                }
                                @if (userInfoDTO.PermissionCodes.Contains(PermissionCodes.SystemSettings))
                                {
                                    <li>
                                        <a class="nav-link text-primary pl-5" id="lnkSettings2" href="@Url.Action("Index", "Settings")">@Localizer["Menu_Settings"]</a>
                                    </li>
                                }
                            </ul>
                        </li>
                    }
                    @if (userInfoDTO.PermissionCodes.Contains(PermissionCodes.WebCompetitionView))
                    {
                        <li>
                            <a href="@(Url.Action("Index" , "Competitions"))" id="lnkCompetitions2" class="nav-link"><i class="fas fa-home"></i>@Localizer["Competitions"]</a>
                        </li>
                    }

                    @if (userInfoDTO.PermissionCodes.Contains(PermissionCodes.WebQuestionsView) || userInfoDTO.PermissionCodes.Contains(PermissionCodes.WebQuestionsCreate))
                    {
                        <li>
                            <a class="nav-link dropdown-toggle collapsed" id="lnkQuestions2" href="#Questions" data-toggle="collapse" aria-expanded="false">
                                <i class="fas fa-question-circle"></i> @Localizer["QuestionsBank"]
                            </a>
                            <ul class="list-unstyled collapse" id="Questions">
                                @if (userInfoDTO.PermissionCodes.Contains(PermissionCodes.WebQuestionsView))
                                {
                                    <li>
                                        <a class="nav-link text-primary pl-5" id="lnkQuestionCategory2" href="@Url.Action("Index", "Questions")">@Localizer["QuestionCategory"]</a>
                                    </li>
                                }
                                @if (userInfoDTO.PermissionCodes.Contains(PermissionCodes.WebQuestionsCreate))
                                {
                                    <li>
                                        <a class="nav-link text-primary pl-5" id="lnkQuestionAdd2" href="@Url.Action("AddQuestion", "Questions")">@Localizer["AddQuestions"]</a>
                                    </li>
                                }
                            </ul>
                        </li>
                    }
                    @if (userInfoDTO.PermissionCodes.Contains(PermissionCodes.WebPlayerView))
                    {
                        <li>
                            <a href="@(Url.Action("Index" , "Players"))" id="lnkPlayers2" class="nav-link"><i class="fas fa-users"></i>@Localizer["Players"]</a>
                        </li>
                    }

                    <li class="">
                        <a href="@(Url.Action("Profile" , "Users"))" id="lnkProfile2" class="nav-link"><i class="fas fa-home"></i>@Localizer["Menu_Profile"]</a>
                    </li>
                </ul>
                <!--/ side menu-->
            </div>
            <div class="col-12 col-lg-auto inner-main-div">
                @RenderBody()
                <footer class="footer">
                    <div class="row py-2 pt-4 d-flex align-items-center no-gutters">
                        <div class="col-12 text-dark text-center">
                            <small>
                                <script>document.write(new Date().getFullYear())</script> © @Localizer["CityMall"].
                            </small>
                        </div>
                    </div>
                </footer>
            </div>
        </div>
    </div>
    <div class="WaitingBar" id="loading" style="display: none; opacity: 0.3; height: 100%; width: 100%; position: fixed; left: 0px; top: 0px;
        z-index: 1999; background: rgb(59, 132, 92); justify-content: center; align-items: center;">
        <img src="~/assets/images/spinner-transparent.gif" style="display: block; margin-left: auto; margin-right: auto; width:111px;" />
    </div>

    <script>
        var userLang = '@IsAr' == 'True' ? 'ar' : 'en';
        var IsArabic = '@IsAr' == 'True';
        var publicURls = {
            setCulture: '@Url.Action("SetCulture","Home")',
            //Users-Profile
            logout: '@Url.Action("Logout", "Users")',
            UsersList: '@Url.Action("Index","Users")',
            AddUser: '@Url.Action("AddUser","Users")',
            DeleteUser: '@Url.Action("DeleteUser","Users")',
            ActivateUser: '@Url.Action("ActivateUser","Users")',

            //Categories
            Categories: '@Url.Action("Index","Questions")',
            AddCategory: '@Url.Action("AddCategory","Questions")',
            DeleteCategory: '@Url.Action("DeleteCategory","Questions")',
            DeleteCurrentCategoryImg: '@Url.Action("DeleteExistingImg","Questions")',

            //Questions
            AddNewQuestion: '@Url.Action("AddQuestion","Questions")',
            GetQuestions: '@Url.Action("GetAllQuestions","Questions")',
            DeleteQuestion: '@Url.Action("DeleteQuestion","Questions")',


            //Players
            PlayerList: '@Url.Action("Index","Players")',
            AddNewPlayer: '@Url.Action("CreatePlayer","Players")',
            DeletePlayer: '@Url.Action("DeletePlayer","Players")',

            //Competitions
            CompetitionList: '@Url.Action("Index","Competitions")',
            CreateNewCompetition: '@Url.Action("CreateCompetition","Competitions")',
            DeleteCompetition: '@Url.Action("DeleteCompetition","Competitions")',
            StartCompetition: '@Url.Action("StartCompetition","Competitions")',
            ViewCompetition: '@Url.Action("ViewCompetition","Competitions")',
            GetModalPlayer: '@Url.Action("GetModalPlayer","Competitions")',
            GetPlayerScoreDetails: '@Url.Action("GetPlayerScoreDetails","Competitions")',


            //Settings
            UpdateSettings:'@Url.Action("UpdateSetting","Settings")',
            HomePage:'@Url.Action("Index","Home")',
        };

        var globalResources = {
            EnglishFieldValidation: '@Localizer["EnglishFieldValidation"]',
            ArabicFieldValidation: '@Localizer["ArabicFieldValidation"]',
            ChooseFile: '@Localizer["Choosefile"]',
            ChooseImg: '@Localizer["ChooseImg"]',
            InvalidAttachmentImg: '@Localizer["Message_InvalidImageAttachment"]',
            ErrorOccurred: '@Localizer["ErrorOccurred"]',
            Actions: '@Localizer["Actions"]',
            Yes: '@Localizer["Common_Yes"]',
            No: '@Localizer["Common_No"]',



            //Buttons
            Delete: '@Localizer["Delete"]',
            Edit: '@Localizer["Edit"]',
            Cancel: '@Localizer["Cancel"]',


            //DataTable
            Page: '@Localizer["Page"]',
            Of: '@Localizer["Of"]',
            Pages: '@Localizer["Pages"]',
            First: '@Localizer["First"]',
            Previous: '@Localizer["Previous"]',
            Next: '@Localizer["Next"]',
            Last: '@Localizer["Last"]',

            //Users
            Alert_DeleteUser: '@Localizer["Alert_DeleteUser"]',
            Active: '@Localizer["Active"]',
            InActive: '@Localizer["InActive"]',
            ActivationCancel: '@Localizer["Message_ActivationCancel"]',
            ActivationConfirm: '@Localizer["Message_ActivationConfirm"]',



            //Category
            Alert_DeleteCategory: '@Localizer["Alert_DeleteCategory"]',
            Alert_DeleteCategory_Text: '@Localizer["Alert_DeleteCategory_Text"]',
            Alert_Btn_DeleteOnlyCategory: '@Localizer["Alert_Btn_DeleteOnlyCategory"]',
            Alert_Btn_DeleteCategoryWithQuestion: '@Localizer["Alert_Btn_DeleteCategoryWithQuestion"]',
            Alert_DeleteQuestion: '@Localizer["Alert_DeleteQuestion"]',


            //Questions
            OptionAr: '@Localizer["OptionAr"]',
            OptionEn: '@Localizer["OptionEn"]',
            PleaseSelectCorrectAnswerBeforeContinue: '@Localizer["PleaseSelectCorrectAnswerBeforeContinue"]',
            QuestionText: '@Localizer["QuestionText"]',
            QuestionTimer: '@Localizer["QuestionTimer"]',
            QuestionPoints: '@Localizer["QuestionPoint"]',
            PleaseAddTwoOptions: '@Localizer["PleaseAddTwoOptionsAtLeast"]',
            PleaseAddTwoImagesAtLeast: '@Localizer["PleaseAddTwoImagesAtLeast"]',
            OptionRequired: '@Localizer["OptionRequired"]',
            Message_PleaseCheckDuplicatedAnsweresImage: '@Localizer["Message_PleaseCheckDuplicatedAnsweresImage"]',

            //Players
            Alert_DeletePlayer: '@Localizer["Alert_DeletePlayer"]',
            Blocked: '@Localizer["Blocked"]',
            NonBlocked: '@Localizer["NonBlocked"]',

            //Competitons
            Alert_DeleteCompetition: '@Localizer["Alert_DeleteCompetition"]',
            StartCompetition: '@Localizer["StartCompetition"]',
            ViewCompetitionScores: '@Localizer["ViewCompetitionScores"]',

            //Settings
            SystemSettingsUpdated: '@Localizer["SystemSettingsUpdatedSuccessfully"]',
        };
    </script>
</body>
</html>
