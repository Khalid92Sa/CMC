@using Microsoft.AspNetCore.Http;
@using CMC.Presentation.Application.DTOs.Identity
@using Newtonsoft.Json
@inject IHttpContextAccessor HttpContextAccessor

@{
    bool IsAr = Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName == "ar";
    UserDTO userInfoDTO = HttpContextAccessor.HttpContext.Session.GetString("UserInfoDTO") != null ?
        JsonConvert.DeserializeObject<UserDTO>(HttpContextAccessor.HttpContext.Session.GetString("UserInfoDTO")) : null;
}

<header id="page-topbar">
    <div class="navbar-header">
        <div class="d-flex">
            <!-- LOGO -->
            <div class="navbar-brand-box">
                <a href="@Url.Action("Index","Dashboard")" class="logo logo-light">
                    <span class="logo-sm">
                        <img src="~/assets/images/logos/logo.png" alt="logo-sm-light" height="22">
                    </span>
                    <span class="logo-lg">
                        <img src="~/assets/images/logos/logo.png" alt="logo-light" width="200">
                    </span>
                </a>
            </div>

            <button type="button" class="btn btn-sm px-3 font-size-24 header-item waves-effect" id="vertical-menu-btn">
                <i class="ri-menu-2-line align-middle"></i>
            </button>
        </div>

        <div class="d-flex nav-item">
            <div class="phoca-flag-flags tr"></div>
        </div>
        <div class="d-flex">
            <div class="dropdown d-inline-block user-dropdown" style="padding-top: 8%;margin:0px 10px">
                @if(IsAr)
                {
                    <div class="phoca-flag-flags gb" onclick="GeneralClass.ToggleLanguage('en-US')" style="width: 50px;cursor:pointer"></div>
                }
                else
                {
                    <div class="phoca-flag-flags jo" onclick="GeneralClass.ToggleLanguage('ar-JO')" style="width: 50px;cursor:pointer"></div>
                }
            </div>

            <div class="dropdown d-none d-lg-inline-block ms-1">
                <button type="button" class="btn header-item noti-icon waves-effect"
                        data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="ri-apps-2-line"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-lg dropdown-menu-end">
                    <div class="px-lg-2">
                        <div class="row g-0">
                            <div class="col">
                                <a class="dropdown-icon-item" href="#">
                                    <img src="~/assets/images/applications/ekyc.png" alt="Github">
                                    <span>E-KYC</span>
                                </a>
                            </div>
                            <div class="col">
                                <a class="dropdown-icon-item" href="#">
                                    <img src="~/assets/images/applications/eforms.png" alt="bitbucket">
                                    <span>Online Accounts</span>
                                </a>
                            </div>
                            <div class="col">
                                <a class="dropdown-icon-item" href="#">
                                    <img src="~/assets/images/applications/mortgage.jpg" alt="dribbble">
                                    <span>MarketPlace</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="dropdown d-inline-block user-dropdown">
                <button type="button" class="btn header-item waves-effect" id="page-header-user-dropdown"
                        data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <img class="rounded-circle header-profile-user" src="~/assets/images/users/avatar-2.jpg"
                         alt="Header Avatar">
                    @if (userInfoDTO != null)
                    {
                        <span class="d-none d-xl-inline-block ms-1">@userInfoDTO.Name</span>
                    }
                    <i class="mdi mdi-chevron-down d-none d-xl-inline-block"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-end">
                    <!-- item-->
                    <a class="dropdown-item" href="#"><i class="ri-user-line align-middle me-1"></i> @Localizer["Profile"]</a>
                    <a class="dropdown-item d-block" href="#">
                        <span class="badge bg-success float-end mt-1">11</span><i class="ri-settings-2-line align-middle me-1"></i> @Localizer["Settings"]</a>
                    <div class="dropdown-divider"></div>
                    <a class="dropdown-item text-danger" href="#" onclick="Login.SignOut()"<i class="ri-shut-down-line align-middle me-1 text-danger"></i> @Localizer["Logout"]</a>
                </div>
            </div>

        </div>
    </div>
</header>
