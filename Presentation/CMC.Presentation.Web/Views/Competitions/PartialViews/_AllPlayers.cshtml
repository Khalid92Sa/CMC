@model CMC.Presentation.Application.DTOs.Competitions.CompetitionStartDTO

@{
    ViewData["Title"] = "";
    bool IsAr = Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName == "ar";
}

<div class="competition-home-container">
    <div class="logo-section">
        <img src="~/assets/competition/images/Citymall.svg" alt="City Mall Logo" />
    </div>

    <div class="teams-container">
        <!-- Team 1 - City Mall -->
        <div class="team-section">
            <div class="team-title">@Model.Team1Name</div>
            <div class="players-grid">
                @foreach (var player in Model.TeamCityMall)
                {
                    string points = player.Points == 0 || player.Points > 2 && player.Points < 11 ? Localizer["Points"].Value :
                    player.Points == 2 ? Localizer["TwoPoint"].Value : Localizer["Point"].Value;

                    string initials = player.Name.Split(' ').Take(2).Select(n => n.Substring(0, 1)).Aggregate((a, b) => a + b);

                    <div class="player-card cityMallPlayers" data-player-Id="@player.Id">
                        <div class="player-avatar">
                            @if (!string.IsNullOrEmpty(player.ProfilePicture))
                            {
                                <img src="data:image/jpeg;base64,@player.ProfilePicture" alt="@player.Name" />
                            }
                            else
                            {
                                <span class="initials">@initials</span>
                            }
                        </div>
                        <div class="player-name">@player.Name</div>
                        @if(Model.IsFinalCompetition)
                        {
                            <div class="player-score">@player.Points @points</div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- VS Section -->
        <div class="vs-section">
            <div class="vs-circle" id="img-vs">
                VS
            </div>
            <button class="battle-back-btn" id="battle-back-btn">
                <i class="fas fa-exchange-alt"></i>
                <span class="tooltip-text">Change Players</span>
            </button>
        </div>

        <!-- Team 2 - Other Team -->
        <div class="team-section">
            <div class="team-title">@Model.Team2Name</div>
            <div class="players-grid">
                @foreach (var player in Model.OtherTeam)
                {
                    string points = player.Points == 0 || player.Points > 2 && player.Points < 11 ? Localizer["Points"].Value :
                    player.Points == 2 ? Localizer["TwoPoint"].Value : Localizer["Point"].Value;

                    string initials = player.Name.Split(' ').Take(2).Select(n => n.Substring(0, 1)).Aggregate((a, b) => a + b);

                    <div class="player-card OtherPlayers" data-player-Id="@player.Id">
                        <div class="player-avatar">
                            @if (!string.IsNullOrEmpty(player.ProfilePicture))
                            {
                                <img src="data:image/jpeg;base64,@player.ProfilePicture" alt="@player.Name" />
                            }
                            else
                            {
                                <span class="initials">@initials</span>
                            }
                        </div>
                        <div class="player-name">@player.Name</div>
                        @if(Model.IsFinalCompetition)
                        {
                            <div class="player-score">@player.Points @points</div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    var isFinalCompetition = '@Model.IsFinalCompetition.ToString().ToLower()' == 'true';
    var isRoundCompetition = '@Model.IsQuestionsTypeIsRound.ToString().ToLower()' == 'true';
    var isBattleMode = false;
</script>
