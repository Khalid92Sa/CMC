@model CMC.Presentation.Application.DTOs.Competitions.CompetitionStartDTO

@{
    ViewData["Title"] = "";
    bool IsAr = Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName == "ar";
}

<div class="competition-background-overlay">
    <img class="min-vh-100" src="~/assets/competition/images/Home-Background.png" style="width:100%; position:absolute; top:0; left:0;" />
</div>

<div class="player-details-container">
    <div class="row m-0 w-100">
        <!-- Logo Section -->
        <div class="col-md-12 text-center mb-4" id="btn-back">
            <div class="competition-logo-section">
                <img src="~/assets/competition/images/Citymall.svg" alt="City Mall Logo" />
            </div>
        </div>

        <!-- City Mall Team Scores -->
        <div class="col-md-12" id="dv-CityMallScores">
            <div class="row">
                <div class="animated fadeInDownBig col-md-12">
                    <div class="team-title-header title-team-name" data-name="city-mall">
                        @Model.Team1Name
                    </div>

                    <!-- Top Player -->
                    <div class="row justify-content-center mb-4">
                        @{
                            var TopPlayer = Model.TeamCityMall.OrderByDescending(a => a.Points).FirstOrDefault();
                            string TopPoints = TopPlayer.Points == 0 || TopPlayer.Points > 2 && TopPlayer.Points < 11 ? Localizer["Points"].Value :
                            TopPlayer.Points == 2 ? Localizer["TwoPoint"].Value : Localizer["Point"].Value;
                        }
                        <div class="col-md-4">
                            <div class="player-card-competition animated fadeInUpBig" data-player-id="@TopPlayer.Id" data-city-mall="true">
                                <div class="winner-crown" style="top: -15px;">👑</div>
                                <img src="~/assets/competition/images/player.svg" class="player-avatar-competition" alt="Player Avatar" />
                                <div class="player-name-competition">@TopPlayer.Name</div>
                                <div class="player-score-badge">
                                    @TopPlayer.Points @TopPoints
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Other Players -->
            <div class="row">
                <div class="animated fadeInDownBig col-md-12">
                    <div class="row animated fadeInUpBig">
                        @{
                            var OtherCityMallList = Model.TeamCityMall.Where(a => a != TopPlayer).OrderByDescending(a => a.Points).ToList();
                        }
                        @foreach (var player in OtherCityMallList)
                        {
                            string points = player.Points == 0 || player.Points > 2 && player.Points < 11 ? Localizer["Points"].Value :
                            player.Points == 2 ? Localizer["TwoPoint"].Value : Localizer["Point"].Value;

                            <div class="col-md-4">
                                <div class="player-card-competition" data-player-id="@player.Id" data-city-mall="true">
                                    <img src="~/assets/competition/images/player.svg" class="player-avatar-competition" alt="Player Avatar" />
                                    <div class="player-name-competition">@player.Name</div>
                                    <div class="player-score-badge">
                                        @player.Points @points
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Other Team Scores -->
        <div class="col-md-12" id="dv-OtherTeamScores" style="display:none">
            <div class="row">
                <div class="animated fadeInDownBig col-md-12">
                    <div class="team-title-header title-team-name" data-name="other-team">
                        @Model.Team2Name
                    </div>

                    <!-- Top Player -->
                    <div class="row justify-content-center mb-4">
                        @{
                            var otherTopPlayer = Model.OtherTeam.OrderByDescending(a => a.Points).FirstOrDefault();
                            string otherTopPoints = otherTopPlayer.Points == 0 || otherTopPlayer.Points > 2 && otherTopPlayer.Points < 11 ? Localizer["Points"].Value :
                            otherTopPlayer.Points == 2 ? Localizer["TwoPoint"].Value : Localizer["Point"].Value;
                        }
                        <div class="col-md-4">
                            <div class="player-card-competition animated fadeInUpBig" data-player-id="@otherTopPlayer.Id" data-city-mall="false">
                                <div class="winner-crown" style="top: -15px;">👑</div>
                                <img src="~/assets/competition/images/player.svg" class="player-avatar-competition" alt="Player Avatar" />
                                <div class="player-name-competition">@otherTopPlayer.Name</div>
                                <div class="player-score-badge">
                                    @otherTopPlayer.Points @otherTopPoints
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Other Players -->
            <div class="row">
                <div class="animated fadeInDownBig col-md-12">
                    <div class="row animated fadeInUpBig">
                        @{
                            var OtherTeamList = Model.OtherTeam.Where(a => a != otherTopPlayer).OrderByDescending(a => a.Points).ToList();
                        }
                        @foreach (var player in OtherTeamList)
                        {
                            string points = player.Points == 0 || player.Points > 2 && player.Points < 11 ? Localizer["Points"].Value :
                            player.Points == 2 ? Localizer["TwoPoint"].Value : Localizer["Point"].Value;

                            <div class="col-md-4">
                                <div class="player-card-competition" data-player-id="@player.Id" data-city-mall="false">
                                    <img src="~/assets/competition/images/player.svg" class="player-avatar-competition" alt="Player Avatar" />
                                    <div class="player-name-competition">@player.Name</div>
                                    <div class="player-score-badge">
                                        @player.Points @points
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="dv-modal-score"></div>

<script>
    $(document).ready(function () {
        StartCompetition.OnLoadScoresDetails();
    });
</script>