@using CMC.Kernel.Core.Enums;
@model CMC.Presentation.Application.DTOs.Competitions.CompetitionStartDTO

@{
    ViewData["Title"] = "";
    bool IsAr = Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName == "ar";
}

<style>
    .action-buttons-container {
        display: flex;
        gap: 15px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .secondary-btn {
        background-color: #6c757d;
        border-color: #6c757d;
    }

    .secondary-btn:hover {
        background-color: #5a6268;
        border-color: #545b62;
    }

    .confirm-section {
        flex: 1;
        min-width: 200px;
    }

    @@media (max-width: 768px) {
        .action-buttons-container {
            flex-direction: column;
        }
        
        .confirm-section {
            width: 100%;
        }
    }
</style>

<div class="competition-body">
    <div class="competition-container">
        <!-- Left Player Section -->
        <div class="player-section left" id="dv-Other-player" style="cursor:pointer">
            @{
                var otherPlayer = Model.OtherTeam.Where(a => a.IsVSPlayer).SingleOrDefault();
                string otherPoints = otherPlayer.Points == 0 || otherPlayer.Points > 2 && otherPlayer.Points < 11 ? Localizer["Points"].Value :
                otherPlayer.Points == 2 ? Localizer["TwoPoint"].Value : Localizer["Point"].Value;

                string otherInitials = otherPlayer.Name.Split(' ').Take(2).Select(n => n.Substring(0, 1)).Aggregate((a, b) => a + b);
                string otherFirstName = otherPlayer.Name.Split(' ').FirstOrDefault();
            }

            @if (!string.IsNullOrEmpty(otherPlayer.ProfilePicture))
            {
                <div class="player-name">@otherFirstName</div>
                <div class="d-flex justify-content-center position-relative" id="dv-other-player-timer">
                    <div class="player-avatar">
                        <img src="data:image/jpeg;base64,@otherPlayer.ProfilePicture" alt="@otherPlayer.Name" />
                    </div>
                </div>
            }
            else
            {
                <div class="d-flex justify-content-center position-relative" id="dv-other-player-timer">
                    <div class="player-avatar">
                        <span class="initials">@otherInitials</span>
                    </div>
                </div>
                <div class="player-name">@otherPlayer.Name</div>
            }

            @if (Model.IsFinalCompetition)
            {
                <div class="player-score">@otherPlayer.Points @otherPoints</div>
            }
            <input type="hidden" value="@otherPlayer.Id" class="hdn-oPlayer" />
        </div>

        <!-- Right Player Section -->
        <div class="player-section right" id="dv-cityMall-player" style="cursor:pointer">
            @{
                var playerCityMall = Model.TeamCityMall.Where(a => a.IsVSPlayer).SingleOrDefault();
                string points = playerCityMall.Points == 0 || playerCityMall.Points > 2 && playerCityMall.Points < 11 ? Localizer["Points"].Value :
                playerCityMall.Points == 2 ? Localizer["TwoPoint"].Value : Localizer["Point"].Value;

                string initials = playerCityMall.Name.Split(' ').Take(2).Select(n => n.Substring(0, 1)).Aggregate((a, b) => a + b);
                string firstName = playerCityMall.Name.Split(' ').FirstOrDefault();
            }

            @if (!string.IsNullOrEmpty(playerCityMall.ProfilePicture))
            {
                <div class="player-name">@firstName</div>
                <div class="d-flex justify-content-center position-relative" id="dv-citymall-player-timer">
                    <div class="player-avatar">
                        <img src="data:image/jpeg;base64,@playerCityMall.ProfilePicture" alt="@playerCityMall.Name" />
                    </div>
                </div>
            }
            else
            {
                <div class="d-flex justify-content-center position-relative" id="dv-citymall-player-timer">
                    <div class="player-avatar">
                        <span class="initials">@initials</span>
                    </div>
                </div>
                <div class="player-name">@playerCityMall.Name</div>
            }

            @if (Model.IsFinalCompetition)
            {
                <div class="player-score">@playerCityMall.Points @points</div>
            }
            <input type="hidden" value="@playerCityMall.Id" class="hdn-cPlayer" />
        </div>

        <!-- Question Section -->
        <div class="question-section" id="card-main" style="display:none">
            <div class="question-header">
                <h2 class="question-title">@Localizer["TheQuestion"]</h2>
            </div>

            <!-- Question Content Container (for partial view replacement) -->
            <div id="question-content-container">
                <partial name="_QuestionContent.cshtml" model="Model" />
            </div>
           
            <!-- Timer Display -->
            <div class="timer-display d-none" id="dv-p-timer">
                <span id="p-timer"></span>
            </div>

            <div class="action-buttons-container">
                <!-- Confirm Button -->
                <div class="confirm-section" id="dv-confirm" style="visibility:hidden">
                    <button class="confirm-btn" type="button" id="btn-answer">
                        <span class="button-text">@Localizer["Continue"]</span>
                        <div class="fill-container"></div>
                    </button>
                </div>

                <!-- Change Question Button -->
                <div class="confirm-section" id="dv-change-question" style="visibility:hidden">
                    <button class="confirm-btn secondary-btn" type="button" id="btn-change-question" data-val-categoryId="">
                        <span class="button-text">@Localizer["ChangeQuestion"]</span>
                        <div class="fill-container"></div>
                    </button>
                </div>
            </div>
            

            <!-- Navigation Buttons -->
            <div class="confirm-section" id="dv-homePage" style="visibility:hidden">
                <button class="confirm-btn" id="btn-goHomePage">
                    <span class="button-text" id="spn-lbl-goTo">@Localizer["Back"]</span>
                    <div class="fill-container"></div>
                </button>
            </div>

            <!-- Show scrore Buttons -->
            <div class="confirm-section" id="dv-viewScore" style="visibility:hidden">
                <button class="confirm-btn" id="btn-goToScore">
                    <span class="button-text" id="spn-lbl-goToScore">@Localizer["Back"]</span>
                    <div class="fill-container"></div>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        playersInCompetition.CityMallPlayer = '';
        playersInCompetition.OtherPlayer = '';
        var timerFinishedSound = document.getElementById('timerFinishedSound');
        var correctAnswerSound = document.getElementById('correctAnswerSound');
        var InCorrectAnswerSound = document.getElementById('InCorrectAnswerSound');
    });
</script>