@using CMC.Kernel.Core.Constants;
@using CMC.Presentation.Application.Services.Settings;
@model CMC.Presentation.Application.DTOs.Competitions.CompetitionStartDTO
@inject ISettingsService SettingService
@{
    ViewData["Title"] = "";
    bool IsAr = Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName == "ar";
}

<div class="competition-body">
    <div class="category-selection-container">
        <!-- Logo Section -->
        <div class="competition-logo-section">
            <img src="~/assets/competition/images/Citymall.svg" alt="City Mall Logo" />
        </div>

        <!-- Instruction Title -->
        <div class="instruction-title">
            @Localizer["ChooseTheQuestionSectionFromTheFollowingSections"]
        </div>

        <!-- Categories Grid -->
        <div class="categories-grid">
            @foreach (var category in Model.Categories)
            {
                string categoryName = IsAr ? category.NameAr : category.NameEn;
                <div class="category-card glass-card select-category" data-Id="@category.Id">
                    <div class="category-title">
                        @categoryName
                    </div>
                    <div class="category-image-container">
                        @{
                            string ApplicationName = configuration.GetValue<string>("ApplicationName");
                            string imgPath = !string.IsNullOrEmpty(category.Img) ? $"data:image/jpeg;base64,{category.Img}" : $"{ApplicationName}{SettingService.GetValue<string>(SystemSettings.DefaultCategoryImgPath).GetAwaiter().GetResult()}";
                        }
                        <img src="@imgPath" alt="@categoryName" class="category-image" />
                    </div>
                    @* <button class="category-button select-category" data-Id="@category.Id">
                        @Localizer["ChooseCategory"]
                    </button> *@
                </div>
            }
        </div>
    </div>
</div>