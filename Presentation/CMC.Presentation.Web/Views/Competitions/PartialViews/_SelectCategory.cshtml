@model CMC.Presentation.Application.DTOs.Competitions.CompetitionStartDTO

@{
    ViewData["Title"] = "";
    bool IsAr = Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName == "ar";
}

<div class="" style="z-index:-1000;">
    <img class="min-vh-100" src="assets/images/Questions-Background.png" style="width:100%; position:absolute; top:0; left:0;" />
</div>
<div class="row m-0 w-100">
    <div class="col-md-12 text-center">
        <img src="assets/images/Citymall.svg" />
    </div>
    <div class="col-md-10 offset-md-1 mt-5">
        <div class="row">
            <div class="col-md-12">
                <span class="h2 h2-responsive d-flex justify-content-center text-center white-color">@Localizer["ChooseTheQuestionSectionFromTheFollowingSections"]</span>
                <div class="row mt-5 h-100">
                    @foreach(var category in Model.Categories)
                    {
                        string categoryName = IsAr ? category.NameAr : category.NameEn;
                        <div class="animated zoomIn col">
                            <div class="card bg-accent1 rounded">
                                <div class="card-body">
                                    <div class="h4 h4-responsive text-center mt-3">
                                        @categoryName
                                    </div>
                                    <div class="d-flex justify-content-center my-5">
                                        <img src="@category.Img" alt="@categoryName" style="width:70%" />
                                    </div>
                                    <div class=" d-flex justify-content-center mt-2 mb-4">
                                        <button class="button">
                                            <span class="button-text select-category" data-Id="@category.Id">@Localizer["ChooseCategory"]</span>
                                            <div class="fill-container"></div>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>