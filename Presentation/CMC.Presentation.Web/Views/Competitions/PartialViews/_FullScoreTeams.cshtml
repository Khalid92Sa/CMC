@model CMC.Presentation.Application.DTOs.Competitions.CompetitionStartDTO

@{
    ViewData["Title"] = "";
    bool IsAr = Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName == "ar";
}

<div class="competition-body">
    <div class="competition-container score-container">
        <!-- Logo Section -->
        <div class="competition-logo-section" id="go-home-page-bg">
            <img src="~/assets/competition/images/Citymall.svg" alt="City Mall Logo" />
        </div>

        <!-- Teams Score Container -->
        <div class="teams-score-container">
            @{
                int CityMallPoints = Model.TeamCityMall.Sum(a => a.Points);
                string points = CityMallPoints == 0 || CityMallPoints > 2 && CityMallPoints < 11 ? Localizer["Points"].Value :
                CityMallPoints == 2 ? Localizer["TwoPoint"].Value : Localizer["Point"].Value;

                int OtherTeamPoints = Model.OtherTeam.Sum(a => a.Points);
                string Otherpoints = OtherTeamPoints == 0 || OtherTeamPoints > 2 && OtherTeamPoints < 11 ? Localizer["Points"].Value :
                OtherTeamPoints == 2 ? Localizer["TwoPoint"].Value : Localizer["Point"].Value;

                bool team1Wins = CityMallPoints > OtherTeamPoints;
                bool team2Wins = OtherTeamPoints > CityMallPoints;
            }

            <!-- Team 1 Score -->
            <div class="team-score-section glass-card full-team-score-name" data-score="city-mall">
                @if (team1Wins)
                {
                    <div class="winner-crown">👑</div>
                }
                @if (Model.IsFinalCompetition)
                {
                    <div class="competition-team-name">@Model.TeamCityMall.FirstOrDefault()?.Name</div>
                }
                else
                {
                    <div class="competition-team-name">@Model.Team1Name</div>
                }
                <div class="competition-team-score">@CityMallPoints</div>
                <div class="score-points-text">@points</div>
            </div>

            <!-- VS Section -->
            <div class="competition-vs-section">
                <div class="competition-vs-circle">
                    VS
                </div>
            </div>

            <!-- Team 2 Score -->
            <div class="team-score-section glass-card full-team-score-name" data-score="visitors">
                @if (team2Wins)
                {
                    <div class="winner-crown">👑</div>
                }
                @if (Model.IsFinalCompetition)
                {
                    <div class="competition-team-name">@Model.OtherTeam.FirstOrDefault()?.Name</div>
                }
                else
                {
                    <div class="competition-team-name">@Model.Team2Name</div>
                }
                <div class="competition-team-score">@OtherTeamPoints</div>
                <div class="score-points-text">@Otherpoints</div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        StartCompetition.OnLoadFullScore();
    });
</script>