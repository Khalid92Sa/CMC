@model CMC.Presentation.Application.DTOs.Competitions.CompetitionStartDTO
@using CMC.Kernel.Core.Constants

@{
    ViewData["Title"] = "";
    bool IsAr = Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName == "ar";
    string baseURL = configuration.GetValue<string>("BaseURL");
    Layout = "~/Views/Shared/_CompetitionLayout.cshtml";
    bool IsTest = configuration.GetValue<bool>("IsTest");
}

<div class="container-fluid py-3 main-padding d-flex flex-grow-1 position-relative  align-items-start">
  <section id="dv-partial" style="width:100%">
        @if (ViewData["Partial"] != null)
        {
            @Html.Raw(ViewData["Partial"].ToString())
        }
  </section>
       
</div>

<script src="~/assets/js/Application/Competition.js"></script>
<script>
    var _isTest = '@IsTest.ToString().ToLower()' == 'true';
    StartCompetition.OnLoad();
</script>