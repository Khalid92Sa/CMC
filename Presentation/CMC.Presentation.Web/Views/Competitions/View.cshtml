@model CMC.Presentation.Application.DTOs.Competitions.ViewCompetitionScoresDTO
@{
    ViewData["Title"] = Model.Id.HasValue ? Localizer["EditCompetition"].Value : Localizer["CreateCompetition"].Value;
    bool IsAr = Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName == "ar";
}


<div class="flex flex-column justify-content-center align-items-center">
    <div class="row justify-content-between">
        <div class="col-12 d-flex flex-row justify-content-between">
            <h6 class="justify-content-start align-middle align-self-center mb-3">@Localizer["ViewCompetitionScoresTitle"] : @Model.Name </h6>
        </div>
    </div>
    <div class="card">
        <div class="card-body">
            <div class="register py-3 p-md-4 h-100" style="overflow-y: auto">
                <input type="hidden" asp-for="Id" />
                <div class="mb-2">
                    <div class="form-group">
                        <div class="form-row">
                            <div class="form-group col-md-3">
                                <label class="requiredLabel">@Localizer["CompetitionName"]</label>
                                <input class="form-control" type="text" asp-for="Name" autocomplete="off" disabled="disabled" readonly="readonly" />
                            </div>
                            <div class="form-group col-md-3">
                                @{
                                    string StartDate = Model.StartDate.HasValue ? Model.StartDate.Value.Date.ToString("yyyy/MM/dd") : "";
                                }
                                <label class="requiredLabel">@Localizer["CompetitionStartDate"]</label>
                                <input class="form-control" type="text" asp-for="StartDate" value="@StartDate" disabled="disabled" readonly="readonly" onkeypress="return GeneralClass.validationNumbersOnly(this,event)" autocomplete="off" />
                            </div>
                            <div class="form-group col-md-3">
                                @{
                                    string EndDate = Model.EndDate.HasValue ? Model.EndDate.Value.Date.ToString("yyyy/MM/dd") : "";
                                }
                                <label class="requiredLabel">@Localizer["CompetitionEndDate"]</label>
                                <input class="form-control" type="text" asp-for="EndDate" value="@EndDate" disabled="disabled" readonly="readonly" onkeypress="return GeneralClass.validationNumbersOnly(this,event)" autocomplete="off" />
                            </div>
                            <div class="form-group col-md-3">
                                <label class="requiredLabel">@Localizer["CompetitionHost"]</label>
                                <input class="form-control" type="text" asp-for="HostName" autocomplete="off" disabled="disabled" readonly="readonly" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mb-2">
                    <div class="form-group">
                        <div class="form-row">
                            <div class="form-group col-md-3">
                                <label class="requiredLabel">@Localizer["QuestionCategory"]</label>
                                <select class="form-control animated fadeIn js-example-basic-single" disabled="disabled" readonly="readonly" multiple asp-for="CategoriesIds" asp-items="@(new SelectList(Model.Categories, "Id", IsAr ? "NameAr" : "NameEn"))">
                                    <option value="0">@Localizer["All"]</option>
                                </select>
                            </div>
                            <div class="form-group col-md-3">
                                <label class="requiredLabel">@Localizer["RoundCount"]</label>
                                <input class="form-control" type="text" asp-for="RoundCount" autocomplete="off" disabled="disabled" readonly="readonly" />
                            </div>
                            <div class="form-group col-md-3">
                                <label class="">@Localizer["IfCompetitionBasedOnAnotherCompetition"]</label>
                                <input class="form-control" type="text" asp-for="ParentCompetitionName" autocomplete="off" disabled="disabled" readonly="readonly" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mb-2">
                    <h6 class="mb-3">@Localizer["CalculatingRounds"]</h6>
                </div>
                <div class="mb-2 round-1">
                    <h6 class="mb-3">@Localizer["Round1"]</h6>
                </div>
                <div class="mb-2 round-1">
                    <div class="form-row">
                        <div class="form-group col-md-3">
                            <label class="requiredLabel">@Localizer["QuestionTime"]</label>
                            <input class="form-control" type="text" asp-for="Round1Time" disabled="disabled" readonly="readonly"  onkeypress="return GeneralClass.validationNumbersOnly(this,event)" autocomplete="off" />
                        </div>
                        <div class="form-group col-md-3">
                            <label class="requiredLabel">@Localizer["QuestionPoint"]</label>
                            <input class="form-control" type="text" asp-for="Round1Points" disabled="disabled" readonly="readonly" onkeypress="return GeneralClass.validationNumbersOnly(this,event)" autocomplete="off" />
                        </div>
                    </div>
                </div>
                <div class="mb-2 round-2 d-none">
                    <h6 class="mb-3">@Localizer["Round2"]</h6>
                </div>
                <div class="mb-2 round-2 d-none">
                    <div class="form-row">
                        <div class="form-group col-md-3">
                            <label class="requiredLabel">@Localizer["QuestionTime"]</label>
                            <input class="form-control" type="text" asp-for="Round2Time" disabled="disabled" readonly="readonly" onkeypress="return GeneralClass.validationNumbersOnly(this,event)" autocomplete="off" />
                        </div>
                        <div class="form-group col-md-3">
                            <label class="requiredLabel">@Localizer["QuestionPoint"]</label>
                            <input class="form-control" type="text" asp-for="Round2Points" disabled="disabled" readonly="readonly" onkeypress="return GeneralClass.validationNumbersOnly(this,event)" autocomplete="off" />
                        </div>
                    </div>
                </div>
                <div class="mb-2 round-3 d-none">
                    <h6 class="mb-3">@Localizer["Round3"]</h6>
                </div>
                <div class="mb-2 round-3 d-none">
                    <div class="form-row">
                        <div class="form-group col-md-3">
                            <label class="requiredLabel">@Localizer["QuestionTime"]</label>
                            <input class="form-control" type="text" asp-for="Round3Time" disabled="disabled" readonly="readonly" onkeypress="return GeneralClass.validationNumbersOnly(this,event)" autocomplete="off" />
                        </div>
                        <div class="form-group col-md-3">
                            <label class="requiredLabel">@Localizer["QuestionPoint"]</label>
                            <input class="form-control" type="text" asp-for="Round3Points" disabled="disabled" readonly="readonly" onkeypress="return GeneralClass.validationNumbersOnly(this,event)" autocomplete="off" />
                        </div>
                    </div>
                </div>
                <div class="mb-2 round-4 d-none">
                    <h6 class="mb-3">@Localizer["Round4"]</h6>
                </div>
                <div class="mb-2 round-4 d-none">
                    <div class="form-row">
                        <div class="form-group col-md-3">
                            <label class="requiredLabel">@Localizer["QuestionTime"]</label>
                            <input class="form-control" type="text" asp-for="Round4Time" disabled="disabled" readonly="readonly" onkeypress="return GeneralClass.validationNumbersOnly(this,event)" autocomplete="off" />
                        </div>
                        <div class="form-group col-md-3">
                            <label class="requiredLabel">@Localizer["QuestionPoint"]</label>
                            <input class="form-control" type="text" asp-for="Round4Points" disabled="disabled" readonly="readonly" onkeypress="return GeneralClass.validationNumbersOnly(this,event)" autocomplete="off" />
                        </div>
                    </div>
                </div>


                <div class="mb-2">
                    <h6 class="mb-3">@Localizer["WinningTeamInformation"]</h6>
                    <div class="form-row">
                        <div class="form-group col-md-3">
                            <label class="">@Localizer["WinningTeam"]</label>
                            <input class="form-control" type="text" value="@Model.WinningTeamName" disabled="disabled" readonly="readonly" />
                        </div>
                        <div class="form-group col-md-3">
                            <label class="">@Localizer["WinningPlayer"]</label>
                            <input class="form-control" type="text" value="@Model.WinningPlayerName" disabled="disabled" readonly="readonly" />
                        </div>
                        <div class="form-group col-md-3">
                            <label class="">@Localizer["WinningPlayerPoints"]</label>
                            <input class="form-control" type="text" value="@Model.TotalWinningPlayerScore" disabled="disabled" readonly="readonly" />
                        </div>
                    </div>
                </div>


                <div class="mb-2">
                    <h6 class="mb-3">@Localizer["Team1"]</h6>
                    <div class="form-row">
                        <div class="form-group col-md-3">
                            <label class="requiredLabel">@Localizer["Team1Name"]</label>
                            <input class="form-control" type="text" asp-for="Team1Name" disabled="disabled" readonly="readonly" />
                            <span asp-validation-for="Team1Name" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-row">
                        @{
                            int counter = 1;
                        }
                        @foreach (var player in Model.TeamCityMall)
                        {
                            string playerOrder = Localizer[$"Player{counter}"].Value;
                            <div class="form-group col-md-3" data-player-Id="@player.Id" style="cursor:pointer">
                                <label class="">@playerOrder</label>
                                <input class="form-control" type="text" value="@player.Name" disabled="disabled" readonly="readonly" />
                            </div>
                            counter++;
                        }
                    </div>
                </div>
                <div class="mb-2">
                    <h6 class="mb-3">@Localizer["Team2"]</h6>
                    <div class="form-row">
                        <div class="form-group col-md-3">
                            <label class="requiredLabel">@Localizer["Team2Name"]</label>
                            <input class="form-control" type="text" asp-for="Team2Name" disabled="disabled" readonly="readonly" />
                        </div>
                    </div>
                    <div class="form-row">
                        @{
                            int counterOther = 1;
                        }
                        @foreach (var player in Model.OtherTeam)
                        {
                            string playerOrder = Localizer[$"Player{counterOther}"].Value;
                            <div class="form-group col-md-3" data-player-Id="@player.Id" style="cursor:pointer">
                                <label class="">@playerOrder</label>
                                <input class="form-control" type="text" value="@player.Name" disabled="disabled" readonly="readonly" />
                            </div>
                            counterOther++;
                        }
                    </div>
                </div>
                <div class="col-12 text-center">
                    <button type="button" class="btn btn-secondary" onclick="window.location.href='@Url.Action("Index", "Competitions")';">@Localizer["Cancel"]</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- end row -->
<script src="~/assets/js/Application/Competition.js"></script>

<script>
    CompetitionForm.OnLoad();
    GeneralClass.ActivationSubMenuItem('#lnkCompetitions', '#lnkCompetitions');
    GeneralClass.ActivationSubMenuItem('#lnkCompetitions2', '#lnkCompetitions2');
</script>