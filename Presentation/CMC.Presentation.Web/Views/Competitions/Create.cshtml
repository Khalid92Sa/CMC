@model CMC.Presentation.Application.DTOs.Competitions.CompetitionsDTO

@using Microsoft.AspNetCore.Http;
@using CMC.Kernel.Core.Constants
@using CMC.Presentation.Application.DTOs.Identity
@using Newtonsoft.Json
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = Model.Id.HasValue ? Localizer["EditCompetition"].Value : Localizer["CreateCompetition"].Value;
    bool IsAr = Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName == "ar";

    UserDTO userInfoDTO = HttpContextAccessor.HttpContext.Session.GetString("UserInfoDTO") != null ?
      JsonConvert.DeserializeObject<UserDTO>(HttpContextAccessor.HttpContext.Session.GetString("UserInfoDTO")) : null;
}


<form method="post" id="form-competition" enctype="multipart/form-data" asp-controller="Competitions" asp-action="CreateCompetition">
    <div class="flex flex-column justify-content-center align-items-center">
        <div class="row justify-content-between">
            <div class="col-12 d-flex flex-row justify-content-between">
                @if (Model.Id.HasValue)
                {
                    <h6 class="justify-content-start align-middle align-self-center mb-3">@Localizer["EditCompetition"] : @Model.Name </h6>
                }
                else
                {
                    <h6 class="justify-content-start align-middle align-self-center mb-3">@Localizer["CreateCompetition"]</h6>
                }
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <div class="register py-3 p-md-4 h-100" style="overflow-y: auto">
                    <input type="hidden" asp-for="Id" />
                    <div class="mb-2">
                        <div class="form-group">
                            <div class="form-row">
                                <div class="form-group col-md-3">
                                    <label class="requiredLabel">@Localizer["CompetitionName"]</label>
                                    <input class="form-control" type="text" asp-for="Name" autocomplete="off" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-3">
                                    @{
                                        string StartDate = Model.StartDate.HasValue ? Model.StartDate.Value.Date.ToString("yyyy/MM/dd") : "";
                                    }
                                    <label class="requiredLabel">@Localizer["CompetitionStartDate"]</label>
                                    <input class="form-control" type="text" asp-for="StartDate" value="@StartDate" onkeypress="return GeneralClass.validationNumbersOnly(this,event)" autocomplete="off" />
                                    <span asp-validation-for="StartDate" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-3">
                                    <label class="requiredLabel">@Localizer["CompetitionHost"]</label>
                                    <select class="form-control animated fadeIn js-example-basic-single" asp-for="HostID" asp-items="@(new SelectList(Model.Hosts, "Id", IsAr ? "NameAr" : "NameEn"))">
                                        <option value="">@Localizer["Select"]</option>
                                    </select>
                                    <span asp-validation-for="HostID" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="mb-2">
                        <div class="form-group">
                            <div class="form-row">
                                <div class="form-group col-md-3">
                                    <label class="requiredLabel">@Localizer["QuestionCategory"]</label>
                                    <select class="form-control animated fadeIn js-example-basic-single" multiple asp-for="CategoriesIds" asp-items="@(new SelectList(Model.Categories, "Id", IsAr ? "NameAr" : "NameEn"))">
                                        <option value="0">@Localizer["All"]</option>
                                    </select>
                                    <span asp-validation-for="CategoriesIds" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-3">
                                    <label class="requiredLabel">@Localizer["RoundCount"]</label>
                                    <select class="form-control animated fadeIn js-example-basic-single" asp-for="RoundCount">
                                        <option value="1">1</option>
                                        <option value="2">2</option>
                                        <option value="3">3</option>
                                        <option value="4">4</option>
                                    </select>
                                    <span asp-validation-for="RoundCount" class="text-danger"></span>
                                </div>
                                <div class="form-group col-md-3">
                                    <label class="">@Localizer["IfCompetitionBasedOnAnotherCompetition"]</label>
                                    <select class="form-control animated fadeIn js-example-basic-single" asp-for="ParentId" asp-items="@(new SelectList(Model.ParentCompetition, "Id", IsAr ? "NameAr" : "NameEn"))">
                                        <option value="">@Localizer["Select"]</option>
                                    </select>
                                    <span asp-validation-for="ParentId" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="mb-2">
                        <h6 class="mb-3">@Localizer["CalculatingRounds"]</h6>
                    </div>
                    <div class="mb-2 round-1">
                        <h6 class="mb-3">@Localizer["Round1"]</h6>
                    </div>
                    <div class="mb-2 round-1">
                        <div class="form-row">
                            <div class="form-group col-md-3">
                                <label class="requiredLabel">@Localizer["QuestionTime"]</label>
                                <input class="form-control" type="text" asp-for="Round1Time" onkeypress="return GeneralClass.validationNumbersOnly(this,event)" autocomplete="off" />
                                <span asp-validation-for="Round1Time" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-3">
                                <label class="requiredLabel">@Localizer["QuestionPoint"]</label>
                                <input class="form-control" type="text" asp-for="Round1Points" onkeypress="return GeneralClass.validationNumbersOnly(this,event)" autocomplete="off" />
                                <span asp-validation-for="Round1Points" class="text-danger"></span>
                            </div>
                        </div>
                     </div>
                    <div class="mb-2 round-2 d-none">
                        <h6 class="mb-3">@Localizer["Round2"]</h6>
                    </div>
                    <div class="mb-2 round-2 d-none">
                        <div class="form-row">
                            <div class="form-group col-md-3">
                                <label class="requiredLabel">@Localizer["QuestionTime"]</label>
                                <input class="form-control" type="text" asp-for="Round2Time" onkeypress="return GeneralClass.validationNumbersOnly(this,event)" autocomplete="off" />
                                <span asp-validation-for="Round2Time" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-3">
                                <label class="requiredLabel">@Localizer["QuestionPoint"]</label>
                                <input class="form-control" type="text" asp-for="Round2Points" onkeypress="return GeneralClass.validationNumbersOnly(this,event)" autocomplete="off" />
                                <span asp-validation-for="Round2Points" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="mb-2 round-3 d-none">
                        <h6 class="mb-3">@Localizer["Round3"]</h6>
                    </div>
                    <div class="mb-2 round-3 d-none">
                        <div class="form-row">
                            <div class="form-group col-md-3">
                                <label class="requiredLabel">@Localizer["QuestionTime"]</label>
                                <input class="form-control" type="text" asp-for="Round3Time" onkeypress="return GeneralClass.validationNumbersOnly(this,event)" autocomplete="off" />
                                <span asp-validation-for="Round3Time" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-3">
                                <label class="requiredLabel">@Localizer["QuestionPoint"]</label>
                                <input class="form-control" type="text" asp-for="Round3Points" onkeypress="return GeneralClass.validationNumbersOnly(this,event)" autocomplete="off" />
                                <span asp-validation-for="Round3Points" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="mb-2 round-4 d-none">
                        <h6 class="mb-3">@Localizer["Round4"]</h6>
                    </div>
                    <div class="mb-2 round-4 d-none">
                        <div class="form-row">
                            <div class="form-group col-md-3">
                                <label class="requiredLabel">@Localizer["QuestionTime"]</label>
                                <input class="form-control" type="text" asp-for="Round4Time" onkeypress="return GeneralClass.validationNumbersOnly(this,event)" autocomplete="off" />
                                <span asp-validation-for="Round4Time" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-3">
                                <label class="requiredLabel">@Localizer["QuestionPoint"]</label>
                                <input class="form-control" type="text" asp-for="Round4Points" onkeypress="return GeneralClass.validationNumbersOnly(this,event)" autocomplete="off" />
                                <span asp-validation-for="Round4Points" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="mb-2">
                        <h6 class="mb-3">@Localizer["Team1"]</h6>
                        <div class="form-row">
                            <div class="form-group col-md-3">
                                <label class="requiredLabel">@Localizer["Team1Name"]</label>
                                <input class="form-control" type="text" asp-for="Team1Name" />
                                <span asp-validation-for="Team1Name" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-3">
                                <label class="requiredLabel">@Localizer["Player1"]</label>
                                <select class="form-control animated fadeIn js-example-basic-single teams city-mall-team" asp-for="Team1.Player1" asp-items="@(new SelectList(Model.CityMallTeam, "Id", IsAr ? "NameAr" : "NameEn"))">
                                    <option value="">@Localizer["Select"]</option>
                                </select>
                                <span asp-validation-for="Team1.Player1" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-3">
                                <label class="">@Localizer["Player2"]</label>
                                <select class="form-control animated fadeIn js-example-basic-single teams city-mall-team" asp-for="Team1.Player2" asp-items="@(new SelectList(Model.CityMallTeam, "Id", IsAr ? "NameAr" : "NameEn"))">
                                    <option value="">@Localizer["Select"]</option>
                                </select>
                                <span asp-validation-for="Team1.Player2" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-3">
                                <label class="">@Localizer["Player3"]</label>
                                <select class="form-control animated fadeIn js-example-basic-single teams city-mall-team" asp-for="Team1.Player3" asp-items="@(new SelectList(Model.CityMallTeam, "Id", IsAr ? "NameAr" : "NameEn"))">
                                    <option value="">@Localizer["Select"]</option>
                                </select>
                                <span asp-validation-for="Team1.Player3" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-3">
                                <label class="">@Localizer["Player4"]</label>
                                <select class="form-control animated fadeIn js-example-basic-single teams city-mall-team" asp-for="Team1.Player4" asp-items="@(new SelectList(Model.CityMallTeam, "Id", IsAr ? "NameAr" : "NameEn"))">
                                    <option value="">@Localizer["Select"]</option>
                                </select>
                                <span asp-validation-for="Team1.Player4" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="mb-2">
                        <h6 class="mb-3">@Localizer["Team2"]</h6>
                        <div class="form-row">
                            <div class="form-group col-md-3">
                                <label class="requiredLabel">@Localizer["Team2Name"]</label>
                                <input class="form-control" type="text" asp-for="Team2Name" />
                                <span asp-validation-for="Team2Name" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-3">
                                <label class="requiredLabel">@Localizer["Player1"]</label>
                                <select class="form-control animated fadeIn js-example-basic-single teams other-team" asp-for="Team2.Player1" asp-items="@(new SelectList(Model.OtherTeam, "Id", IsAr ? "NameAr" : "NameEn"))">
                                    <option value="">@Localizer["Select"]</option>
                                </select>
                                <span asp-validation-for="Team2.Player1" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-3">
                                <label class="">@Localizer["Player2"]</label>
                                <select class="form-control animated fadeIn js-example-basic-single teams other-team" asp-for="Team2.Player2" asp-items="@(new SelectList(Model.OtherTeam, "Id", IsAr ? "NameAr" : "NameEn"))">
                                    <option value="">@Localizer["Select"]</option>
                                </select>
                                <span asp-validation-for="Team2.Player2" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-3">
                                <label class="">@Localizer["Player3"]</label>
                                <select class="form-control animated fadeIn js-example-basic-single teams other-team" asp-for="Team2.Player3" asp-items="@(new SelectList(Model.OtherTeam, "Id", IsAr ? "NameAr" : "NameEn"))">
                                    <option value="">@Localizer["Select"]</option>
                                </select>
                                <span asp-validation-for="Team2.Player3" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-3">
                                <label class="">@Localizer["Player4"]</label>
                                <select class="form-control animated fadeIn js-example-basic-single teams other-team" asp-for="Team2.Player4" asp-items="@(new SelectList(Model.OtherTeam, "Id", IsAr ? "NameAr" : "NameEn"))">
                                    <option value="">@Localizer["Select"]</option>
                                </select>
                                <span asp-validation-for="Team2.Player4" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 text-center">
                        <button type="button" class="btn btn-primary" onclick="CompetitionForm.CreateOrUpdate()">@Localizer["Save"]</button>
                        <button type="button" class="btn btn-secondary" onclick="window.location.href='@Url.Action("Index", "Competitions")';">@Localizer["Cancel"]</button>
                        @if (Model.LatestScores != null && Model.LatestScores.Count > 0)
                        {
                            <button type="button" class="btn btn-info" id="btnScoreModal" onclick="OpenModalScore()">@Localizer["ViewLastCompeitionScores"]</button>
                        }
                        @if (Model.Id.HasValue && userInfoDTO.PermissionCodes.Contains(PermissionCodes.WebCompetitionDelete))
                        {
                            <button type="button" class="btn btn-danger" onclick="CompetitionForm.DeleteCompetition()">@Localizer["Delete"]</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>


@if (Model.LatestScores != null && Model.LatestScores.Count > 0)
{
    int counter = 1;
    <div class="modal fade" id="LatestScoresModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">@Localizer["ViewLastCompeitionScores"]</h5>
                </div>
                <div class="modal-body">
                    <table class="table table-sm table-striped NoPagenation">
                        <thead>
                            <tr>
                                <th scope="col" style="width:70px;">#</th>
                                <th scope="col">@Localizer["CompetitionName"]</th>
                                <th scope="col">@Localizer["CompetitionEndDate"]</th>
                                <th scope="col">@Localizer["WinningTeam"]</th>
                                <th scope="col">@Localizer["WinningPlayerFromCityMall"]</th>
                                <th scope="col">@Localizer["WinningPlayerFromOtherTeam"]</th>
                            </tr>
                            @foreach (var player in Model.LatestScores)
                            {
                                <tr>
                                    <td>
                                        @counter
                                    </td>
                                    <td>
                                        @player.CompeititonName
                                    </td>
                                    <td>
                                        @player.EndDate.Value.ToString("dd-MM-yyyy")
                                    </td>
                                    <td>
                                        @player.WinningTeamName
                                    </td>
                                    <td>
                                        @player.WinningCityMallPlayerName / @player.CityMallPlayerPoints @Localizer["Points"]
                                    </td>
                                    <td>
                                        @player.WinningOtherPlayerName / @player.OtherPlayerPoints @Localizer["Points"]
                                    </td>
                                </tr>
                                counter++;
                            }
                        </thead>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" onclick="closeModal()" data-bs-dismiss="modal">@Localizer["Close"]</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- end row -->
<script src="~/assets/js/Application/Competition.js"></script>

<script>
    CompetitionForm.OnLoad();
    GeneralClass.ActivationSubMenuItem('#lnkCompetitions', '#lnkCompetitions');
    GeneralClass.ActivationSubMenuItem('#lnkCompetitions2', '#lnkCompetitions2');
    function OpenModalScore() {
        $('#LatestScoresModal').modal('show');
    }
    function closeModal() {
        $('#LatestScoresModal').modal('hide');
    }
</script>